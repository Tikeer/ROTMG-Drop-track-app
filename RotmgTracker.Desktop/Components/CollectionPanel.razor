@using Microsoft.AspNetCore.Components.Web.Virtualization
@inherits StateAwareComponent
@inject GameDataService GameData
@inject ItemSourceService ItemSources

<div class="section-header">
    <h2>Item Collection — Trophy Hall</h2>
    <div style="display: flex; gap: 8px; align-items: center;">
        <button type="button"
                class="btn btn-sm @(ViewMode == "TROPHY" ? "btn-primary" : "")"
                @onclick='() => SetViewMode("TROPHY")'>Trophy Hall</button>
        <button type="button"
                class="btn btn-sm @(ViewMode == "GRID" ? "btn-primary" : "")"
                @onclick='() => SetViewMode("GRID")'>Flat Grid</button>
    </div>
</div>

@{
    EnsureComputedView();

    var scopeOptions = new List<DarkSelectOption>
    {
        new("ALL", "All characters"),
        new("ACTIVE", $"Active: {State.ActiveCharacter.FormattedTitle}")
    };

    var categoryOptions = new List<DarkSelectOption>
    {
        new("ALL", "All Categories"),
        new("LEGENDARY_WHITE", "Legendary Whites", BagObjectType: 0x050C, FallbackBag: BagType.WhiteBag),
        new("EVENT_WHITE", "Realm Whites", BagObjectType: 0x050C, FallbackBag: BagType.WhiteBag),
        new("REGULAR_WHITE", "Regular Whites", BagObjectType: 0x050C, FallbackBag: BagType.WhiteBag),
        new("ST", "ST Sets", BagObjectType: 0x050F, FallbackBag: BagType.OrangeBag),
        new("SHINY", $"Shiny Variants ({_shinyCatalogCount})", Color: "#f472b6", BagObjectType: 0x050C, FallbackBag: BagType.WhiteBag)
    };
}

<div class="quest-add-bar" style="flex-wrap: wrap; gap: 8px; overflow: visible;">
    <input class="input" style="min-width: 210px; max-width: 250px;" placeholder="Search item, boss, or dungeon..." @bind="CollectionSearch" @bind:event="oninput" />

    <DarkSelect Value="@(_scope == DataScope.ActiveCharacter ? "ACTIVE" : "ALL")"
                ValueChanged="OnScopeValueChanged"
                Options="@scopeOptions"
                MinWidth="148px"
                Title="Whose drops & completions count" />

    <DarkSelect Value="@CollectionCategoryFilter"
                ValueChanged="v => CollectionCategoryFilter = v"
                Options="@categoryOptions"
                MinWidth="156px"
                Title="Filter by item category" />

    <DarkSelect Value="@CollectionOwnershipFilter"
                ValueChanged="v => CollectionOwnershipFilter = v"
                Options="@OwnershipOptions"
                MinWidth="142px"
                Title="Filter by ownership" />

    @if (ViewMode == "TROPHY")
    {
        <DarkSelect Value="@SortMode"
                    ValueChanged="v => SortMode = v"
                    Options="@SortOptions"
                    MinWidth="148px"
                    Title="Sort dungeons" />
    }

    <label class="checkbox-label filter-check-pill" title="Show retired Legacy items">
        <input type="checkbox" @bind="IncludeLegacy" />
        <span>Legacy</span>
    </label>

    <label class="checkbox-label filter-check-pill" title="Show seasonal / holiday reskins">
        <input type="checkbox" @bind="IncludeReskins" />
        <span>Reskins</span>
    </label>

    <label class="checkbox-label filter-check-pill" title="Include tiered equipment split by Weapon/Armor vs Ability/Ring">
        <input type="checkbox" @bind="CollectionIncludeTiered" />
        <span>Tiered</span>
    </label>

    @if (CollectionIncludeTiered)
    {
        <div class="tiered-split-group">
            <span class="tiered-split-lbl">W/A:</span>
            <DarkSelect Value="@MinWeaponArmorTier.ToString()"
                        ValueChanged="v => MinWeaponArmorTier = int.TryParse(v, out int n) ? n : 12"
                        Options="@WeaponArmorTierOptions"
                        MinWidth="76px"
                        Compact="true"
                        Title="Minimum Weapon & Armor tier" />

            <span class="tiered-split-lbl">Abil/Ring:</span>
            <DarkSelect Value="@MinAbilityRingTier.ToString()"
                        ValueChanged="v => MinAbilityRingTier = int.TryParse(v, out int n) ? n : 6"
                        Options="@AbilityRingTierOptions"
                        MinWidth="76px"
                        Compact="true"
                        Title="Minimum Ability & Ring tier" />
        </div>
    }
</div>

<div class="collection-summary-bar">
    <div>
        Showing <strong>@_shownItemCount</strong> items • In this view:
        <strong style="color: var(--accent-green);">@_ownedInView / @_shownItemCount</strong> (@_viewPct%)
        • Overall: <strong style="color: var(--accent-gold);">@_overallProgress.Owned / @_overallProgress.Total</strong> (@_overallProgress.Percent%)
    </div>
    <div style="font-size: 0.78rem; color: var(--text-muted);">
        Dungeons: <strong>@_renderedRows.Count</strong> • Completions in scope: <strong>@_runsCount</strong>
    </div>
</div>

@if (ViewMode == "TROPHY")
{
    if (_renderedRows.Count == 0 && _tieredSection == null && _uncategorizedRow == null)
    {
        <div class="empty-state">No collection items match the current filters.</div>
    }
    else
    {
        @if (_tieredSection != null)
        {
            <div class="tiered-hall-card" @onmouseleave="HideRichTooltip">
                <div class="tiered-hall-head">
                    <div class="inline-meta-item" style="gap: 10px;">
                        <GameSprite BagObjectType="0x06AC" FallbackBagType="BagType.RedBag" Size="26" />
                        <div>
                            <strong style="font-size: 0.96rem; color: var(--text-primary);">Tiered Equipment</strong>
                            <div style="font-size: 0.74rem; color: var(--text-muted);">
                                Weapons &amp; Armors (@(MinWeaponArmorTier > 0 ? $"T{MinWeaponArmorTier}+" : "Off")) • Abilities &amp; Rings (@(MinAbilityRingTier > 0 ? $"T{MinAbilityRingTier}+" : "Off"))
                            </div>
                        </div>
                    </div>
                    <div class="th-col-pct" style="min-width: 140px;">
                        <div class="trophy-pct-text">
                            <strong>@_tieredSection.OwnedCount/@_tieredSection.TotalCount</strong>
                            <span>@_tieredSection.PercentText</span>
                        </div>
                        <div class="trophy-mini-bar">
                            <div class="trophy-mini-fill" style="width: @_tieredSection.BarWidth"></div>
                        </div>
                    </div>
                </div>

                <div class="trophy-boss-stack">
                    @foreach (var grp in _tieredSection.Groups)
                    {
                        <div class="trophy-boss-line">
                            <div class="trophy-boss-badge tiered-group-badge">
                                <span class="trophy-boss-name">@grp.Label</span>
                                <span class="rarity-opt-slots">@grp.OwnedCount/@grp.Tiles.Count</span>
                            </div>
                            <div class="trophy-boss-items">
                                @foreach (var tile in grp.Tiles)
                                {
                                    <div class="@tile.CssClass"
                                         @onmouseenter="e => ShowRichTooltip(tile, e)"
                                         @onmouseleave="HideRichTooltip">
                                        @if (!string.IsNullOrEmpty(tile.SpriteStyle))
                                        {
                                            <span class="game-sprite" style="@tile.SpriteStyle"></span>
                                        }
                                        @if (!string.IsNullOrEmpty(tile.RarityOverlayStyle))
                                        {
                                            <span class="trophy-rarity-mark"><span class="game-sprite" style="@tile.RarityOverlayStyle"></span></span>
                                        }
                                        @if (tile.CountTag != null)
                                        {
                                            <span class="trophy-count-tag">@tile.CountTag</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="trophy-table-header">
            <div class="th-col-dungeon">Dungeon</div>
            <div class="th-col-graves">Graves</div>
            <div class="th-col-comp">Comp</div>
            <div class="th-col-pct">Progress</div>
            <div class="th-col-items">Collectibles by Boss &amp; ST Sets (hover for details &amp; rarities)</div>
        </div>

        <div class="trophy-list" @onmouseleave="HideRichTooltip">
            @foreach (var row in _renderedRows)
            {
                <div class="trophy-row @(row.IsComplete ? "trophy-row-complete" : "")">
                    <div class="th-col-dungeon inline-meta-item" style="gap: 10px;">
                        @if (!string.IsNullOrEmpty(row.PortalStyle))
                        {
                            <span class="game-sprite-wrap" style="width:28px;height:28px;" title="@row.DungeonName">
                                <span class="game-sprite" style="@row.PortalStyle"></span>
                            </span>
                        }
                        <span class="trophy-dungeon-name" title="@row.DungeonName">@row.DungeonName</span>
                    </div>

                    <div class="th-col-graves">
                        @if (row.Graves > 0)
                        {
                            <span class="graves-pill @row.GravesClass">
                                @row.GravesText
                                <UiIcon Name="skull" Size="11" />
                            </span>
                        }
                        else
                        {
                            <span style="color: var(--text-muted); font-size: 0.78rem;">—</span>
                        }
                    </div>

                    <div class="th-col-comp">
                        <span class="trophy-comp-val @(row.Completions > 0 ? "has-comp" : "")">@row.Completions</span>
                    </div>

                    <div class="th-col-pct">
                        <div class="trophy-pct-text">
                            <strong>@row.OwnedCount/@row.TotalCount</strong>
                            <span>@row.PercentText</span>
                        </div>
                        <div class="trophy-mini-bar">
                            <div class="trophy-mini-fill" style="width: @row.BarWidth"></div>
                        </div>
                    </div>

                    <div class="th-col-items trophy-boss-stack">
                        @foreach (var bg in row.BossGroups)
                        {
                            <div class="trophy-boss-line">
                                <div class="trophy-boss-badge" title="@bg.BossName">
                                    @if (!string.IsNullOrEmpty(bg.BossSpriteStyle))
                                    {
                                        <span class="game-sprite-wrap" style="width:22px;height:22px;">
                                            <span class="game-sprite" style="@bg.BossSpriteStyle"></span>
                                        </span>
                                    }
                                    <span class="trophy-boss-name">@bg.BossName</span>
                                </div>

                                <div class="trophy-boss-items">
                                    @foreach (var tile in bg.Tiles)
                                    {
                                        <div class="@tile.CssClass"
                                             @onmouseenter="e => ShowRichTooltip(tile, e)"
                                             @onmouseleave="HideRichTooltip">
                                            @if (!string.IsNullOrEmpty(tile.SpriteStyle))
                                            {
                                                <span class="game-sprite" style="@tile.SpriteStyle"></span>
                                            }
                                            @if (tile.IsShiny && !string.IsNullOrEmpty(_shinyOverlayStyle))
                                            {
                                                <span class="trophy-shiny-mark"><span class="game-sprite" style="@_shinyOverlayStyle"></span></span>
                                            }
                                            @if (!string.IsNullOrEmpty(tile.RarityOverlayStyle))
                                            {
                                                <span class="trophy-rarity-mark"><span class="game-sprite" style="@tile.RarityOverlayStyle"></span></span>
                                            }
                                            @if (tile.CountTag != null)
                                            {
                                                <span class="trophy-count-tag">@tile.CountTag</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (row.StTiles.Count > 0)
                        {
                            <div class="trophy-st-line">
                                <div class="trophy-st-badge" title="ST Sets / ST Items dropping in @row.DungeonName">
                                    @if (!string.IsNullOrEmpty(_stBagSpriteStyle))
                                    {
                                        <span class="game-sprite-wrap" style="width:20px;height:20px;">
                                            <span class="game-sprite" style="@_stBagSpriteStyle"></span>
                                        </span>
                                    }
                                    <span>ST Sets / Items</span>
                                </div>

                                <div class="trophy-boss-items">
                                    @foreach (var tile in row.StTiles)
                                    {
                                        <div class="@tile.CssClass"
                                             @onmouseenter="e => ShowRichTooltip(tile, e)"
                                             @onmouseleave="HideRichTooltip">
                                            @if (!string.IsNullOrEmpty(tile.SpriteStyle))
                                            {
                                                <span class="game-sprite" style="@tile.SpriteStyle"></span>
                                            }
                                            @if (tile.IsShiny && !string.IsNullOrEmpty(_shinyOverlayStyle))
                                            {
                                                <span class="trophy-shiny-mark"><span class="game-sprite" style="@_shinyOverlayStyle"></span></span>
                                            }
                                            @if (!string.IsNullOrEmpty(tile.RarityOverlayStyle))
                                            {
                                                <span class="trophy-rarity-mark"><span class="game-sprite" style="@tile.RarityOverlayStyle"></span></span>
                                            }
                                            @if (tile.CountTag != null)
                                            {
                                                <span class="trophy-count-tag">@tile.CountTag</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_uncategorizedRow != null)
        {
            <div class="uncategorized-section">
                <button type="button" class="uncategorized-toggle" @onclick="() => ShowUncategorized = !ShowUncategorized">
                    <span>@(ShowUncategorized ? "▼" : "▶")</span>
                    <span>Other / Event &amp; Special Items (No Dungeon Label)</span>
                    <span class="badge-nossnl badge-readonly">
                        @_uncategorizedRow.OwnedCount / @_uncategorizedRow.TotalCount (@_uncategorizedRow.CompletionPercent.ToString("0.#")%)
                    </span>
                </button>

                @if (ShowUncategorized)
                {
                    <div class="trophy-uncat-grid" @onmouseleave="HideRichTooltip">
                        <Virtualize Items="@_uncatChunks" Context="chunk" ItemSize="44" OverscanCount="6">
                            <div class="trophy-flat-row" style="height: 44px;">
                                @foreach (var tile in chunk)
                                {
                                    <div class="@tile.CssClass"
                                         @onmouseenter="e => ShowRichTooltip(tile, e)"
                                         @onmouseleave="HideRichTooltip">
                                        @if (!string.IsNullOrEmpty(tile.SpriteStyle))
                                        {
                                            <span class="game-sprite" style="@tile.SpriteStyle"></span>
                                        }
                                        @if (tile.IsShiny && !string.IsNullOrEmpty(_shinyOverlayStyle))
                                        {
                                            <span class="trophy-shiny-mark"><span class="game-sprite" style="@_shinyOverlayStyle"></span></span>
                                        }
                                        @if (!string.IsNullOrEmpty(tile.RarityOverlayStyle))
                                        {
                                            <span class="trophy-rarity-mark"><span class="game-sprite" style="@tile.RarityOverlayStyle"></span></span>
                                        }
                                        @if (tile.CountTag != null)
                                        {
                                            <span class="trophy-count-tag">@tile.CountTag</span>
                                        }
                                    </div>
                                }
                            </div>
                        </Virtualize>
                    </div>
                }
            </div>
        }
    }
}
else
{
    if (_flatChunks.Count == 0)
    {
        <div class="empty-state">No collection items match the current filters.</div>
    }
    else
    {
        <div class="trophy-uncat-grid" @onmouseleave="HideRichTooltip">
            <Virtualize Items="@_flatChunks" Context="chunk" ItemSize="48" OverscanCount="8">
                <div class="trophy-flat-row" style="height: 48px;">
                    @foreach (var tile in chunk)
                    {
                        <div class="@tile.CssClass trophy-tile-lg"
                             @onmouseenter="e => ShowRichTooltip(tile, e)"
                             @onmouseleave="HideRichTooltip">
                            @if (!string.IsNullOrEmpty(tile.SpriteStyle))
                            {
                                <span class="game-sprite" style="@tile.SpriteStyle"></span>
                            }
                            @if (tile.IsShiny && !string.IsNullOrEmpty(_shinyOverlayStyle))
                            {
                                <span class="trophy-shiny-mark"><span class="game-sprite" style="@_shinyOverlayStyle"></span></span>
                            }
                            @if (!string.IsNullOrEmpty(tile.RarityOverlayStyle))
                            {
                                <span class="trophy-rarity-mark"><span class="game-sprite" style="@tile.RarityOverlayStyle"></span></span>
                            }
                            @if (tile.CountTag != null)
                            {
                                <span class="trophy-count-tag">@tile.CountTag</span>
                            }
                        </div>
                    }
                </div>
            </Virtualize>
        </div>
    }
}

@* SINGLE SHARED FLOATING RICH TOOLTIP (1 DOM node total -> zero scroll/hover lag!) *@
@if (_hoveredTile != null)
{
    var ht = _hoveredTile;
    string leftPx = $"{_tipX.ToString("0", System.Globalization.CultureInfo.InvariantCulture)}px";
    string topPx = $"{_tipY.ToString("0", System.Globalization.CultureInfo.InvariantCulture)}px";

    <div class="collection-rich-tooltip" style="left: @leftPx; top: @topPx;">
        <div class="crt-header">
            <div class="crt-icon-box">
                @if (!string.IsNullOrEmpty(ht.LargeSpriteStyle))
                {
                    <span class="game-sprite" style="@ht.LargeSpriteStyle"></span>
                }
                @if (ht.IsShiny && !string.IsNullOrEmpty(_shinyOverlayStyle))
                {
                    <span class="trophy-shiny-mark"><span class="game-sprite" style="@_shinyOverlayStyle"></span></span>
                }
                @if (!string.IsNullOrEmpty(ht.RarityOverlayStyle))
                {
                    <span class="trophy-rarity-mark"><span class="game-sprite" style="@ht.RarityOverlayStyle"></span></span>
                }
            </div>

            <div class="crt-title-col">
                <div class="crt-name-row">
                    <strong class="crt-name" style="color: @(ht.IsShiny ? "#f472b6" : "var(--text-primary)");">@ht.Meta.Name</strong>
                    <span class="crt-tier-pill @ht.TierBadgeClass">@ht.TierLabel</span>
                </div>
                <div class="crt-badges-row">
                    @if (ht.IsShiny)
                    {
                        <span class="shiny-pill">SHINY</span>
                    }
                    @if (ht.Meta.IsLegacy)
                    {
                        <span class="crt-tag-muted">LEGACY</span>
                    }
                    @if (ht.Meta.IsReskin)
                    {
                        <span class="crt-tag-muted">RESKIN</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ht.Meta.SetName))
                    {
                        <span class="crt-set-name">@ht.Meta.SetName</span>
                    }
                </div>
            </div>
        </div>

        <div class="crt-stats">
            <div class="crt-stat-item">
                <span>Feed Power</span>
                <strong>@(ht.Meta.FeedPower > 0 ? ht.Meta.FeedPower.ToString("N0") : "—")</strong>
            </div>
            <div class="crt-stat-item">
                <span>Fame Bonus</span>
                <strong style="color: var(--accent-gold);">@(ht.Meta.FameBonus > 0 ? $"+{ht.Meta.FameBonus}%" : "—")</strong>
            </div>
            <div class="crt-stat-item">
                <span>Best Score</span>
                <strong style="color: var(--accent-white);">@(ht.BestScore > 0 ? $"{Math.Round(ht.BestScore)} pts" : "—")</strong>
            </div>
        </div>

        <div class="crt-source">
            <span class="crt-section-lbl">Drops From</span>
            <div class="crt-source-row">
                @if (!string.IsNullOrEmpty(ht.BossSpriteStyle))
                {
                    <span class="game-sprite-wrap" style="width:22px;height:22px;">
                        <span class="game-sprite" style="@ht.BossSpriteStyle"></span>
                    </span>
                }
                <strong class="crt-source-boss">@ht.BossName</strong>
                @if (!string.IsNullOrWhiteSpace(ht.DungeonName))
                {
                    <span style="color: var(--text-muted);">•</span>
                    @if (!string.IsNullOrEmpty(ht.PortalSpriteStyle))
                    {
                        <span class="game-sprite-wrap" style="width:18px;height:18px;">
                            <span class="game-sprite" style="@ht.PortalSpriteStyle"></span>
                        </span>
                    }
                    <span class="crt-source-dungeon">@ht.DungeonName</span>
                }
            </div>
        </div>

        <div class="crt-rarities">
            <div class="crt-rarities-head">
                <span class="crt-section-lbl">Rarities Collected</span>
                <span class="crt-total-owned">@(ht.OwnedCount > 0 ? $"Total x{ht.OwnedCount}" : "Not collected yet")</span>
            </div>
            <div class="crt-rarities-grid">
                @foreach (var r in AllRarities)
                {
                    int cnt = ht.RarityCounts[(int)r];
                    bool got = cnt > 0;
                    string rKey = r.ToString().ToLowerInvariant();
                    <div class="crt-rarity-chip crt-r-@rKey @(got ? "is-collected" : "is-uncollected")">
                        <span class="crt-rarity-icon">
                            @if (r > ItemRarity.Common && _rarityTooltipStyles.TryGetValue(r, out var rIconCss))
                            {
                                <span class="game-sprite" style="@rIconCss"></span>
                            }
                            else
                            {
                                <span class="rarity-common-dot"></span>
                            }
                        </span>
                        <span class="crt-rarity-name">@r</span>
                        <strong class="crt-rarity-cnt">@(got ? $"x{cnt}" : "0")</strong>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly ItemRarity[] AllRarities =
    [
        ItemRarity.Common,
        ItemRarity.Uncommon,
        ItemRarity.Rare,
        ItemRarity.Legendary,
        ItemRarity.Divine
    ];

    private sealed record RenderedTile(
        ItemMetadata Meta,
        string CssClass,
        string SpriteStyle,
        string LargeSpriteStyle,
        bool IsShiny,
        string? RarityOverlayStyle,
        string? CountTag,
        int OwnedCount,
        double BestScore,
        int[] RarityCounts,
        string BossName,
        string BossSpriteStyle,
        string DungeonName,
        string PortalSpriteStyle,
        string TierLabel,
        string TierBadgeClass);

    private sealed record RenderedBossGroup(
        string BossName,
        string BossSpriteStyle,
        List<RenderedTile> Tiles);

    private sealed record RenderedRow(
        string DungeonName,
        string PortalStyle,
        double Graves,
        string GravesText,
        string GravesClass,
        int Completions,
        int OwnedCount,
        int TotalCount,
        string PercentText,
        string BarWidth,
        bool IsComplete,
        List<RenderedBossGroup> BossGroups,
        List<RenderedTile> StTiles);

    private string ViewMode { get; set; } = "TROPHY";
    private string SortMode { get; set; } = "GRAVES";
    private bool ShowUncategorized { get; set; }

    private string CollectionSearch { get; set; } = "";
    private string CollectionCategoryFilter { get; set; } = "ALL";
    private string CollectionOwnershipFilter { get; set; } = "ALL";
    private bool IncludeLegacy { get; set; }
    private bool IncludeReskins { get; set; }
    private bool CollectionIncludeTiered { get; set; }
    private int MinWeaponArmorTier { get; set; } = 12;
    private int MinAbilityRingTier { get; set; } = 6;

    private DataScope _scope = DataScope.AllCharacters;

    // Single floating rich tooltip state
    private RenderedTile? _hoveredTile;
    private double _tipX;
    private double _tipY;

    private string _lastCacheKey = "";
    private int _shinyCatalogCount;
    private string _shinyOverlayStyle = "";
    private string _stBagSpriteStyle = "";
    private readonly Dictionary<ItemRarity, string> _rarityOverlayStyles = new();
    private readonly Dictionary<ItemRarity, string> _rarityTooltipStyles = new();

    private static readonly List<DarkSelectOption> OwnershipOptions =
    [
        new("ALL", "Owned & Missing"),
        new("OWNED", "Owned Only", Color: "#4ade80"),
        new("MISSING", "Missing Only", Color: "#a1a1aa")
    ];

    private static readonly List<DarkSelectOption> SortOptions =
    [
        new("GRAVES", "Sort: Graves ↓"),
        new("PERCENT", "Sort: Progress % ↓"),
        new("COMP", "Sort: Completions ↓"),
        new("NAME", "Sort: Name A–Z")
    ];

    private static readonly List<DarkSelectOption> WeaponArmorTierOptions =
        new[] { new DarkSelectOption("0", "Off") }
            .Concat(Enumerable.Range(1, 14).Select(t => new DarkSelectOption(t.ToString(), $"T{t}+")))
            .ToList();

    private static readonly List<DarkSelectOption> AbilityRingTierOptions =
        new[] { new DarkSelectOption("0", "Off") }
            .Concat(Enumerable.Range(1, 7).Select(t => new DarkSelectOption(t.ToString(), $"T{t}+")))
            .ToList();

    private sealed record TieredGroupView(string Label, int OwnedCount, List<RenderedTile> Tiles);
    private sealed record TieredSectionView(int OwnedCount, int TotalCount, string PercentText, string BarWidth, List<TieredGroupView> Groups);

    private TieredSectionView? _tieredSection;

    private List<RenderedRow> _renderedRows = new();
    private TrophyHallDungeonRow? _uncategorizedRow;
    private List<List<RenderedTile>> _uncatChunks = new();
    private List<List<RenderedTile>> _flatChunks = new();
    private int _shownItemCount;
    private int _ownedInView;
    private double _viewPct;
    private int _runsCount;
    private (int Owned, int Total, double Percent) _overallProgress;

    private void SetViewMode(string mode)
    {
        _hoveredTile = null;
        ViewMode = mode;
    }

    private void OnScopeValueChanged(string val)
    {
        _hoveredTile = null;
        _scope = val == "ACTIVE" ? DataScope.ActiveCharacter : DataScope.AllCharacters;
    }

    private void ShowRichTooltip(RenderedTile tile, MouseEventArgs e)
    {
        _hoveredTile = tile;
        // Place tooltip cleanly near cursor without overflowing right/bottom viewport edges
        double x = e.ClientX + 18;
        double y = e.ClientY + 14;
        if (x > 880) x = Math.Max(16, e.ClientX - 360);
        if (y > 540) y = Math.Max(16, e.ClientY - 265);
        _tipX = x;
        _tipY = y;
    }

    private void HideRichTooltip() => _hoveredTile = null;

    private void EnsureComputedView()
    {
        Guid activeId = State.ActiveCharacter.Id;
        int totalLoot = State.Data.LootHistory.Count;
        int totalRuns = State.Data.DungeonRuns.Count;
        int atlasRev = Sprites.Revision;
        string key = $"{ViewMode}|{SortMode}|{_scope}|{activeId}|{CollectionSearch}|{CollectionCategoryFilter}|{CollectionOwnershipFilter}|{IncludeLegacy}|{IncludeReskins}|{CollectionIncludeTiered}|{MinWeaponArmorTier}|{MinAbilityRingTier}|{totalLoot}|{totalRuns}|{atlasRev}";

        if (key == _lastCacheKey)
            return;

        _lastCacheKey = key;
        _hoveredTile = null;

        _shinyOverlayStyle = Sprites.TryGetUiSprite("shiny_item_icon", out var shinyRect)
            ? Sprites.BuildSpriteCss(shinyRect, 11)
            : "";
        _stBagSpriteStyle = Sprites.TryGetBagSprite(0x050F, BagType.OrangeBag, out var stBagRect)
            ? Sprites.BuildSpriteCss(stBagRect, 18)
            : "";
        _rarityOverlayStyles.Clear();
        _rarityTooltipStyles.Clear();
        foreach (var r in new[] { ItemRarity.Uncommon, ItemRarity.Rare, ItemRarity.Legendary, ItemRarity.Divine })
        {
            if (Sprites.TryGetRarityIconSprite(r, out var rr))
            {
                _rarityOverlayStyles[r] = Sprites.BuildSpriteCss(rr, 15);
                _rarityTooltipStyles[r] = Sprites.BuildSpriteCss(rr, 16);
            }
        }

        var allKnown = GameData.GetAllKnownItems();
        _shinyCatalogCount = allKnown.Count(i =>
            i.IsShiny && i.Quality != DropType.BPs &&
            (IncludeLegacy || !i.IsLegacy) && (IncludeReskins || !i.IsReskin));

        var loot = State.GetLootSnapshot(_scope);
        var runs = State.GetDungeonRunsSnapshot(_scope);
        _runsCount = runs.Count;
        var ownedStatsById = BuildOwnedStatsById(loot);

        _overallProgress = UiHelpers.ComputeCollectionProgress(
            allKnown, loot, CollectionIncludeTiered, MinWeaponArmorTier, MinAbilityRingTier, IncludeLegacy, IncludeReskins);

        if (ViewMode == "TROPHY")
        {
            List<TrophyHallDungeonRow> rawRows;
            bool isDefaultUnfiltered = _scope == DataScope.AllCharacters
                && string.IsNullOrWhiteSpace(CollectionSearch)
                && CollectionCategoryFilter == "ALL"
                && CollectionOwnershipFilter == "ALL"
                && !IncludeLegacy
                && !IncludeReskins
                && !CollectionIncludeTiered;

            if (isDefaultUnfiltered && ItemSources.TryGetCachedDefaultTrophyHall(loot.Count, runs.Count, out var cached))
            {
                rawRows = cached;
                _tieredSection = null;
            }
            else
            {
                var baseFilteredItems = GetFilteredCollectionItems(allKnown, loot, applySearch: false).ToList();
                var tieredItems = baseFilteredItems.Where(i => i.Tier > 0).ToList();
                var nonTieredItems = baseFilteredItems.Where(i => i.Tier < 0).ToList();

                // Build dedicated Tiered Equipment tile in Trophy Hall instead of dumping into Other / Uncategorized
                _tieredSection = BuildTieredSection(tieredItems, ownedStatsById, CollectionSearch.Trim());

                rawRows = ItemSources.BuildTrophyHall(nonTieredItems, loot, runs, GameData);
                if (isDefaultUnfiltered)
                    ItemSources.UpdateCachedDefaultTrophyHall(loot.Count, runs.Count, rawRows);
            }

            string q = CollectionSearch.Trim();
            if (!string.IsNullOrEmpty(q))
            {
                var matched = new List<TrophyHallDungeonRow>();
                foreach (var r in rawRows)
                {
                    if (r.DungeonName.Contains(q, StringComparison.OrdinalIgnoreCase))
                    {
                        matched.Add(r);
                    }
                    else
                    {
                        var matchedBossGroups = new List<TrophyHallBossGroup>();
                        foreach (var bg in r.BossGroups)
                        {
                            if (bg.BossName.Contains(q, StringComparison.OrdinalIgnoreCase))
                                matchedBossGroups.Add(bg);
                            else
                            {
                                var mItems = bg.Items.Where(it => it.Meta.Name.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
                                if (mItems.Count > 0)
                                    matchedBossGroups.Add(new TrophyHallBossGroup(bg.BossName, mItems));
                            }
                        }

                        var matchedSt = r.StItems.Where(it =>
                            it.Meta.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                            it.Meta.SetName.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();

                        if (matchedBossGroups.Count > 0 || matchedSt.Count > 0)
                        {
                            var allMatched = matchedBossGroups.SelectMany(b => b.Items).Concat(matchedSt).ToList();
                            matched.Add(r with { BossGroups = matchedBossGroups, StItems = matchedSt, Items = allMatched });
                        }
                    }
                }
                rawRows = matched;
            }

            _uncategorizedRow = rawRows.FirstOrDefault(r => r.DungeonName.Equals("Other / Uncategorized", StringComparison.OrdinalIgnoreCase));
            _uncatChunks = _uncategorizedRow != null
                ? ChunkList(_uncategorizedRow.Items.Select(e => BuildTile(e.Meta, e.OwnedCount, e.BestRarity, e.BestScore, e.RarityCounts, e.BossName, e.DungeonName, "", 30)).ToList(), 16)
                : new();

            var mapped = rawRows
                .Where(r => !r.DungeonName.Equals("Other / Uncategorized", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var sorted = SortMode switch
            {
                "PERCENT" => mapped.OrderByDescending(r => r.CompletionPercent).ThenByDescending(r => r.OwnedCount).ThenByDescending(r => r.Graves).ToList(),
                "COMP" => mapped.OrderByDescending(r => r.Completions).ThenByDescending(r => r.Graves).ThenBy(r => r.DungeonName).ToList(),
                "NAME" => mapped.OrderBy(r => r.DungeonName, StringComparer.OrdinalIgnoreCase).ToList(),
                _ => mapped.OrderByDescending(r => r.Graves).ThenByDescending(r => r.OwnedCount).ThenBy(r => r.DungeonName).ToList()
            };

            _renderedRows = new List<RenderedRow>(sorted.Count);
            var distinctShownIds = new HashSet<int>();

            foreach (var r in sorted)
            {
                string portalStyle = Sprites.TryGetPortalSprite(r.DungeonName, r.PortalObjectType, out var pRect)
                    ? Sprites.BuildSpriteCss(pRect, 28)
                    : "";
                string portalSmallStyle = pRect.W > 0 ? Sprites.BuildSpriteCss(pRect, 18) : "";

                var renderedBossGroups = new List<RenderedBossGroup>(r.BossGroups.Count);
                foreach (var bg in r.BossGroups)
                {
                    string bossStyle = Sprites.TryGetBossSprite(0, bg.BossName, out var bRect)
                        ? Sprites.BuildSpriteCss(bRect, 22)
                        : "";

                    var tiles = new List<RenderedTile>(bg.Items.Count);
                    foreach (var e in bg.Items)
                    {
                        distinctShownIds.Add(e.Meta.ItemId);
                        tiles.Add(BuildTile(e.Meta, e.OwnedCount, e.BestRarity, e.BestScore, e.RarityCounts, bg.BossName, r.DungeonName, portalSmallStyle, 30, bossStyle));
                    }
                    renderedBossGroups.Add(new RenderedBossGroup(bg.BossName, bossStyle, tiles));
                }

                var stTiles = new List<RenderedTile>(r.StItems.Count);
                foreach (var e in r.StItems)
                {
                    distinctShownIds.Add(e.Meta.ItemId);
                    string stBossStyle = Sprites.TryGetBossSprite(0, e.BossName, out var sbRect)
                        ? Sprites.BuildSpriteCss(sbRect, 22)
                        : _stBagSpriteStyle;
                    stTiles.Add(BuildTile(e.Meta, e.OwnedCount, e.BestRarity, e.BestScore, e.RarityCounts, e.BossName, r.DungeonName, portalSmallStyle, 30, stBossStyle));
                }

                double pct = r.CompletionPercent;
                _renderedRows.Add(new RenderedRow(
                    DungeonName: r.DungeonName,
                    PortalStyle: portalStyle,
                    Graves: r.Graves,
                    GravesText: r.Graves > 0 ? r.Graves.ToString("0.#") : "—",
                    GravesClass: GetGravesTierClass(r.Graves),
                    Completions: r.Completions,
                    OwnedCount: r.OwnedCount,
                    TotalCount: r.TotalCount,
                    PercentText: $"{pct:0.#}%",
                    BarWidth: $"{pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}%",
                    IsComplete: r.OwnedCount == r.TotalCount && r.TotalCount > 0,
                    BossGroups: renderedBossGroups,
                    StTiles: stTiles));
            }

            if (_uncategorizedRow != null)
            {
                foreach (var e in _uncategorizedRow.Items)
                    distinctShownIds.Add(e.Meta.ItemId);
            }

            if (_tieredSection != null)
            {
                foreach (var grp in _tieredSection.Groups)
                    foreach (var t in grp.Tiles)
                        distinctShownIds.Add(t.Meta.ItemId);
            }

            _shownItemCount = distinctShownIds.Count;
            _ownedInView = distinctShownIds.Count(id => ownedStatsById.ContainsKey(id));
            _flatChunks = new();
        }
        else
        {
            var baseFilteredItems = GetFilteredCollectionItems(allKnown, loot, applySearch: true).ToList();
            _renderedRows = new();
            _tieredSection = null;
            _uncategorizedRow = null;
            _uncatChunks = new();

            var flatTiles = new List<RenderedTile>(baseFilteredItems.Count);
            foreach (var item in baseFilteredItems)
            {
                bool owned = ownedStatsById.TryGetValue(item.ItemId, out var st);
                var src = ItemSources.GetPrimarySourceForItem(item.Name);
                string dName = src?.Dungeon ?? "Other / Uncategorized";
                string bName = src?.Boss ?? (item.Quality == DropType.ST && !string.IsNullOrWhiteSpace(item.SetName) ? item.SetName : "Event / Special");
                string bossStyle = Sprites.TryGetBossSprite(0, bName, out var bRect) ? Sprites.BuildSpriteCss(bRect, 22) : "";
                string portalSmall = Sprites.TryGetPortalSprite(dName, 0, out var pRect) ? Sprites.BuildSpriteCss(pRect, 18) : "";

                flatTiles.Add(BuildTile(
                    item,
                    st?.Count ?? 0,
                    st?.BestRarity ?? ItemRarity.Common,
                    st?.BestScore ?? 0,
                    st?.RarityCounts ?? new int[5],
                    bName,
                    dName,
                    portalSmall,
                    34,
                    bossStyle));
            }

            _flatChunks = ChunkList(flatTiles, 14);
            _shownItemCount = baseFilteredItems.Count;
            _ownedInView = baseFilteredItems.Count(i => ownedStatsById.ContainsKey(i.ItemId));
        }

        _viewPct = _shownItemCount > 0 ? Math.Round((double)_ownedInView / _shownItemCount * 100.0, 1) : 0.0;
    }

    private TieredSectionView? BuildTieredSection(
        List<ItemMetadata> tieredItems,
        Dictionary<int, OwnedStats> ownedStatsById,
        string searchQuery)
    {
        if (tieredItems.Count == 0)
            return null;

        IEnumerable<ItemMetadata> items = tieredItems;
        if (!string.IsNullOrWhiteSpace(searchQuery) &&
            !"Tiered Equipment".Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        {
            items = items.Where(i => i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        var list = items.ToList();
        if (list.Count == 0)
            return null;

        var groups = new List<TieredGroupView>();

        // Weapons & Armors grouped by Tier descending (T14 -> T1)
        foreach (var g in list.Where(i => i.IsWeaponOrArmor).GroupBy(i => i.Tier).OrderByDescending(g => g.Key))
        {
            var tiles = g.OrderByDescending(i => ownedStatsById.ContainsKey(i.ItemId))
                .ThenBy(i => i.SlotType)
                .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
                .Select(i =>
                {
                    ownedStatsById.TryGetValue(i.ItemId, out var st);
                    return BuildTile(i, st?.Count ?? 0, st?.BestRarity ?? ItemRarity.Common, st?.BestScore ?? 0,
                        st?.RarityCounts ?? new int[5], $"Tier {g.Key} Drop", "Tiered Equipment", "", 30, "");
                })
                .ToList();
            groups.Add(new TieredGroupView($"T{g.Key} Weapons & Armors", tiles.Count(t => t.OwnedCount > 0), tiles));
        }

        // Abilities & Rings grouped by Tier descending (T7 -> T1)
        foreach (var g in list.Where(i => i.IsAbilityOrRing).GroupBy(i => i.Tier).OrderByDescending(g => g.Key))
        {
            var tiles = g.OrderByDescending(i => ownedStatsById.ContainsKey(i.ItemId))
                .ThenBy(i => i.SlotType)
                .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
                .Select(i =>
                {
                    ownedStatsById.TryGetValue(i.ItemId, out var st);
                    return BuildTile(i, st?.Count ?? 0, st?.BestRarity ?? ItemRarity.Common, st?.BestScore ?? 0,
                        st?.RarityCounts ?? new int[5], $"Tier {g.Key} Drop", "Tiered Equipment", "", 30, "");
                })
                .ToList();
            groups.Add(new TieredGroupView($"T{g.Key} Abilities & Rings", tiles.Count(t => t.OwnedCount > 0), tiles));
        }

        if (groups.Count == 0)
            return null;

        int total = groups.Sum(g => g.Tiles.Count);
        int owned = groups.Sum(g => g.OwnedCount);
        double pct = total > 0 ? Math.Round((double)owned / total * 100.0, 1) : 0.0;
        return new TieredSectionView(
            owned,
            total,
            $"{pct:0.#}%",
            $"{pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}%",
            groups);
    }

    private RenderedTile BuildTile(
        ItemMetadata meta,
        int ownedCount,
        ItemRarity bestRarity,
        double bestScore,
        int[] rarityCounts,
        string bossName,
        string dungeonName,
        string portalSmallStyle,
        int spriteSize,
        string? preResolvedBossStyle = null)
    {
        bool owned = ownedCount > 0;
        ItemRarity displayRarity = owned ? bestRarity : ItemRarity.Common;

        string rarityClass = displayRarity switch
        {
            ItemRarity.Uncommon => "rarity-uncommon",
            ItemRarity.Rare => "rarity-rare",
            ItemRarity.Legendary => "rarity-legendary",
            ItemRarity.Divine => "rarity-divine",
            _ => ""
        };

        string cssClass = owned
            ? $"trophy-tile is-owned {rarityClass}{(meta.IsShiny ? " is-shiny" : "")}"
            : $"trophy-tile is-missing{(meta.IsShiny ? " is-shiny-dim" : "")}";

        string spriteStyle = "";
        string largeSpriteStyle = "";
        if (Sprites.TryGetSprite(meta.TextureFile, meta.TextureIndex, out var rect))
        {
            spriteStyle = Sprites.BuildSpriteCss(rect, spriteSize);
            largeSpriteStyle = Sprites.BuildSpriteCss(rect, 38);
        }

        string? rarityOverlay = displayRarity > ItemRarity.Common && _rarityOverlayStyles.TryGetValue(displayRarity, out var rCss)
            ? rCss
            : null;

        string? countTag = ownedCount > 1 ? $"x{ownedCount}" : null;

        string bossStyle = preResolvedBossStyle
            ?? (Sprites.TryGetBossSprite(0, bossName, out var br) ? Sprites.BuildSpriteCss(br, 22) : "");

        (string tierLabel, string tierClass) = meta.Quality == DropType.ST
            ? ("ST", "tier-st")
            : meta.Tier >= 0
                ? ($"T{meta.Tier}", "tier-tiered")
                : ("UT", "tier-ut");

        return new RenderedTile(
            meta, cssClass, spriteStyle, largeSpriteStyle, meta.IsShiny, rarityOverlay, countTag,
            ownedCount, bestScore, rarityCounts, bossName, bossStyle, dungeonName, portalSmallStyle, tierLabel, tierClass);
    }

    private sealed class OwnedStats
    {
        public int Count;
        public ItemRarity BestRarity;
        public double BestScore;
        public readonly int[] RarityCounts = new int[5];
    }

    private static Dictionary<int, OwnedStats> BuildOwnedStatsById(IReadOnlyList<LootDropRecord> loot)
    {
        var dict = new Dictionary<int, OwnedStats>();
        foreach (var l in loot)
        {
            if (l.ItemId <= 0) continue;
            if (!dict.TryGetValue(l.ItemId, out var prev))
            {
                prev = new OwnedStats();
                dict[l.ItemId] = prev;
            }
            prev.Count++;
            if (l.Rarity > prev.BestRarity) prev.BestRarity = l.Rarity;
            if (l.RarityScore > prev.BestScore) prev.BestScore = l.RarityScore;
            prev.RarityCounts[Math.Clamp((int)l.Rarity, 0, 4)]++;
        }
        return dict;
    }

    private IEnumerable<ItemMetadata> GetFilteredCollectionItems(
        IReadOnlyCollection<ItemMetadata> allKnown,
        IReadOnlyList<LootDropRecord> loot,
        bool applySearch = true)
    {
        var items = allKnown.Where(i => UiHelpers.MatchesCollectionBaseFilter(
            i, CollectionIncludeTiered, MinWeaponArmorTier, MinAbilityRingTier, IncludeLegacy, IncludeReskins));

        items = CollectionCategoryFilter switch
        {
            "LEGENDARY_WHITE" => items.Where(i => i.Quality == DropType.LegendaryWhite && !i.IsShiny),
            "EVENT_WHITE" => items.Where(i => i.Quality == DropType.EventWhite && !i.IsShiny),
            "REGULAR_WHITE" => items.Where(i => i.Quality == DropType.RegularWhite && !i.IsShiny),
            "ST" => items.Where(i => i.Quality == DropType.ST),
            "SHINY" => items.Where(i => i.IsShiny),
            _ => items
        };

        if (applySearch && !string.IsNullOrWhiteSpace(CollectionSearch))
        {
            string q = CollectionSearch.Trim();
            items = items.Where(i =>
                i.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                i.SetName.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        if (CollectionOwnershipFilter != "ALL")
        {
            var ownedIds = loot
                .Where(l => l.ItemId > 0)
                .Select(l => l.ItemId)
                .ToHashSet();

            if (CollectionOwnershipFilter == "OWNED")
                items = items.Where(i => ownedIds.Contains(i.ItemId));
            else if (CollectionOwnershipFilter == "MISSING")
                items = items.Where(i => !ownedIds.Contains(i.ItemId));
        }

        return items.OrderByDescending(i => i.IsShiny).ThenBy(i => i.Name);
    }

    private static List<List<T>> ChunkList<T>(IReadOnlyList<T> source, int size)
    {
        var result = new List<List<T>>((source.Count + size - 1) / size);
        for (int i = 0; i < source.Count; i += size)
        {
            int take = Math.Min(size, source.Count - i);
            var chunk = new List<T>(take);
            for (int j = 0; j < take; j++)
                chunk.Add(source[i + j]);
            result.Add(chunk);
        }
        return result;
    }

    private static string GetGravesTierClass(double graves) => graves switch
    {
        >= 9.0 => "graves-exalt",
        >= 7.0 => "graves-high",
        >= 5.0 => "graves-mid",
        _ => "graves-low"
    };
