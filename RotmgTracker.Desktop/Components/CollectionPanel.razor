@using Microsoft.AspNetCore.Components.Web.Virtualization
@inherits StateAwareComponent
@inject GameDataService GameData
@inject ItemSourceService ItemSources

<div class="section-header">
    <h2>Item Collection — Trophy Hall</h2>
    <div style="display: flex; gap: 8px; align-items: center;">
        <button type="button"
                class="btn btn-sm @(ViewMode == "TROPHY" ? "btn-primary" : "")"
                @onclick='() => SetViewMode("TROPHY")'>Trophy Hall</button>
        <button type="button"
                class="btn btn-sm @(ViewMode == "GRID" ? "btn-primary" : "")"
                @onclick='() => SetViewMode("GRID")'>Flat Grid</button>
    </div>
</div>

<div class="quest-add-bar" style="flex-wrap: wrap; gap: 10px;">
    <input class="input" style="min-width: 210px; max-width: 260px;" placeholder="Search item or dungeon..." @bind="CollectionSearch" @bind:event="oninput" />

    <select class="select" value="@(_scope == DataScope.ActiveCharacter ? "ACTIVE" : "ALL")" @onchange="OnScopeChanged" title="Whose drops & completions count">
        <option value="ALL">All characters</option>
        <option value="ACTIVE">Active: @State.ActiveCharacter.FormattedTitle</option>
    </select>

    <select class="select" @bind="CollectionCategoryFilter">
        <option value="ALL">All Categories</option>
        <option value="LEGENDARY_WHITE">Legendary Whites</option>
        <option value="EVENT_WHITE">Realm Whites</option>
        <option value="REGULAR_WHITE">Regular Whites</option>
        <option value="ST">ST Sets</option>
        <option value="SHINY">Shiny Variants Only (@GameData.GetAllKnownItems().Count(i => i.IsShiny && i.Quality != DropType.BPs))</option>
    </select>

    <select class="select" @bind="CollectionOwnershipFilter">
        <option value="ALL">Owned &amp; Missing</option>
        <option value="OWNED">Owned Only</option>
        <option value="MISSING">Missing Only</option>
    </select>

    @if (ViewMode == "TROPHY")
    {
        <select class="select" @bind="SortMode" title="Sort dungeons">
            <option value="GRAVES">Sort: Graves ↓</option>
            <option value="PERCENT">Sort: Progress % ↓</option>
            <option value="COMP">Sort: Completions ↓</option>
            <option value="NAME">Sort: Name A–Z</option>
        </select>
    }

    <label class="checkbox-label" style="background: var(--bg-input); padding: 7px 10px; border-radius: 8px; border: 1px solid var(--border-color);">
        <input type="checkbox" @bind="CollectionIncludeTiered" />
        Tiered
    </label>

    @if (CollectionIncludeTiered)
    {
        <select class="select" style="padding: 5px 8px;" @bind="CollectionMinTier">
            @for (int t = 1; t <= 14; t++)
            {
                <option value="@t">T@(t)+</option>
            }
        </select>
    }
</div>

@{
    EnsureComputedView();
}

<div class="collection-summary-bar">
    <div>
        Showing <strong>@_shownItemCount</strong> items • In this view:
        <strong style="color: var(--accent-green);">@_ownedInView / @_shownItemCount</strong> (@_viewPct%)
        • Overall: <strong style="color: var(--accent-gold);">@_overallProgress.Owned / @_overallProgress.Total</strong> (@_overallProgress.Percent%)
    </div>
    <div style="font-size: 0.78rem; color: var(--text-muted);">
        Dungeons: <strong>@_trophyRows.Count</strong> • Completions in scope: <strong>@_runsCount</strong>
    </div>
</div>

@if (ViewMode == "TROPHY")
{
    if (_trophyRows.Count == 0 && _uncategorizedRow == null)
    {
        <div class="empty-state">No collection items match the current filters.</div>
    }
    else
    {
        <div class="trophy-table-header">
            <div class="th-col-dungeon">Dungeon</div>
            <div class="th-col-graves">Graves</div>
            <div class="th-col-comp">Comp</div>
            <div class="th-col-pct">Progress</div>
            <div class="th-col-items">Collectibles (hover for name &amp; rarity)</div>
        </div>

        <div class="trophy-list">
            @foreach (var row in _trophyRows)
            {
                <div class="trophy-row @(row.OwnedCount == row.TotalCount && row.TotalCount > 0 ? "trophy-row-complete" : "")">
                    <div class="th-col-dungeon inline-meta-item" style="gap: 10px;">
                        <GameSprite PortalObjectType="row.PortalObjectType" DungeonName="@row.DungeonName" Size="28" Title="@row.DungeonName" />
                        <span class="trophy-dungeon-name" title="@row.DungeonName">@row.DungeonName</span>
                    </div>

                    <div class="th-col-graves">
                        @if (row.Graves > 0)
                        {
                            <span class="graves-pill @GetGravesTierClass(row.Graves)">
                                @row.Graves.ToString("0.#")
                                <UiIcon Name="skull" Size="11" />
                            </span>
                        }
                        else
                        {
                            <span style="color: var(--text-muted); font-size: 0.78rem;">—</span>
                        }
                    </div>

                    <div class="th-col-comp">
                        <span class="trophy-comp-val @(row.Completions > 0 ? "has-comp" : "")">@row.Completions</span>
                    </div>

                    <div class="th-col-pct">
                        <div class="trophy-pct-text">
                            <strong>@row.OwnedCount/@row.TotalCount</strong>
                            <span>@row.CompletionPercent.ToString("0.#")%</span>
                        </div>
                        <div class="trophy-mini-bar">
                            <div class="trophy-mini-fill" style="width: @(row.CompletionPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>

                    <div class="th-col-items">
                        @foreach (var entry in row.Items)
                        {
                            bool owned = entry.OwnedCount > 0;
                            string extra = owned
                                ? $"Owned x{entry.OwnedCount}"
                                : "Missing";

                            <div class="trophy-item-wrap @(owned ? "is-owned" : "is-missing")">
                                <ItemSprite TextureFile="@entry.Meta.TextureFile"
                                            TextureIndex="entry.Meta.TextureIndex"
                                            ItemName="@entry.Meta.Name"
                                            Rarity="@(owned ? entry.BestRarity : ItemRarity.Common)"
                                            IsShiny="entry.Meta.IsShiny"
                                            DropQuality="entry.Meta.Quality"
                                            RarityScore="@(owned ? entry.BestScore : 0)"
                                            ExtraMeta="@extra"
                                            LightweightTooltip="true"
                                            Size="38" />
                                @if (entry.OwnedCount > 1)
                                {
                                    <span class="trophy-count-tag">x@(entry.OwnedCount)</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_uncategorizedRow != null)
        {
            <div class="uncategorized-section">
                <button type="button" class="uncategorized-toggle" @onclick="() => ShowUncategorized = !ShowUncategorized">
                    <span>@(ShowUncategorized ? "▼" : "▶")</span>
                    <span>Other / Event &amp; ST Items (No Dungeon Label)</span>
                    <span class="badge-nossnl badge-readonly">
                        @_uncategorizedRow.OwnedCount / @_uncategorizedRow.TotalCount (@_uncategorizedRow.CompletionPercent.ToString("0.#")%)
                    </span>
                </button>

                @if (ShowUncategorized)
                {
                    <div class="trophy-uncat-grid">
                        <Virtualize Items="@_uncatChunks" Context="chunk" ItemSize="44" OverscanCount="6">
                            <div class="trophy-flat-row" style="height: 44px;">
                                @foreach (var entry in chunk)
                                {
                                    bool owned = entry.OwnedCount > 0;
                                    string extra = owned ? $"Owned x{entry.OwnedCount}" : "Missing";
                                    <div class="trophy-item-wrap @(owned ? "is-owned" : "is-missing")">
                                        <ItemSprite TextureFile="@entry.Meta.TextureFile"
                                                    TextureIndex="entry.Meta.TextureIndex"
                                                    ItemName="@entry.Meta.Name"
                                                    Rarity="@(owned ? entry.BestRarity : ItemRarity.Common)"
                                                    IsShiny="entry.Meta.IsShiny"
                                                    DropQuality="entry.Meta.Quality"
                                                    RarityScore="@(owned ? entry.BestScore : 0)"
                                                    ExtraMeta="@extra"
                                                    LightweightTooltip="true"
                                                    Size="38" />
                                        @if (entry.OwnedCount > 1)
                                        {
                                            <span class="trophy-count-tag">x@(entry.OwnedCount)</span>
                                        }
                                    </div>
                                }
                            </div>
                        </Virtualize>
                    </div>
                }
            </div>
        }
    }
}
else
{
    if (_flatChunks.Count == 0)
    {
        <div class="empty-state">No collection items match the current filters.</div>
    }
    else
    {
        <div class="trophy-uncat-grid">
            <Virtualize Items="@_flatChunks" Context="chunk" ItemSize="48" OverscanCount="8">
                <div class="trophy-flat-row" style="height: 48px;">
                    @foreach (var item in chunk)
                    {
                        bool owned = _ownedStatsById.TryGetValue(item.ItemId, out var st);
                        string extra = owned ? $"Owned x{st.Count}" : "Missing";
                        <div class="trophy-item-wrap @(owned ? "is-owned" : "is-missing")">
                            <ItemSprite TextureFile="@item.TextureFile"
                                        TextureIndex="item.TextureIndex"
                                        ItemName="@item.Name"
                                        Rarity="@(owned ? st.BestRarity : ItemRarity.Common)"
                                        IsShiny="item.IsShiny"
                                        DropQuality="item.Quality"
                                        RarityScore="@(owned ? st.BestScore : 0)"
                                        ExtraMeta="@extra"
                                        LightweightTooltip="true"
                                        Size="42" />
                            @if (owned && st.Count > 1)
                            {
                                <span class="trophy-count-tag">x@(st.Count)</span>
                            }
                        </div>
                    }
                </div>
            </Virtualize>
        </div>
    }
}

@code {
    private string ViewMode { get; set; } = "TROPHY";
    private string SortMode { get; set; } = "GRAVES";
    private bool ShowUncategorized { get; set; }

    private string CollectionSearch { get; set; } = "";
    private string CollectionCategoryFilter { get; set; } = "ALL";
    private string CollectionOwnershipFilter { get; set; } = "ALL";
    private bool CollectionIncludeTiered { get; set; }
    private int CollectionMinTier { get; set; } = 12;

    private DataScope _scope = DataScope.AllCharacters;

    // Cached computed view so scrolling/hovering never recomputes LINQ over 2000+ items
    private string _lastCacheKey = "";
    private List<TrophyHallDungeonRow> _trophyRows = new();
    private TrophyHallDungeonRow? _uncategorizedRow;
    private List<List<TrophyHallItem>> _uncatChunks = new();
    private List<List<ItemMetadata>> _flatChunks = new();
    private Dictionary<int, (int Count, ItemRarity BestRarity, double BestScore)> _ownedStatsById = new();
    private int _shownItemCount;
    private int _ownedInView;
    private double _viewPct;
    private int _runsCount;
    private (int Owned, int Total, double Percent) _overallProgress;

    private void SetViewMode(string mode) => ViewMode = mode;

    private void OnScopeChanged(ChangeEventArgs e)
    {
        _scope = e.Value?.ToString() == "ACTIVE" ? DataScope.ActiveCharacter : DataScope.AllCharacters;
    }

    private void EnsureComputedView()
    {
        Guid activeId = State.ActiveCharacter.Id;
        int totalLoot = State.Data.LootHistory.Count;
        int totalRuns = State.Data.DungeonRuns.Count;
        string key = $"{ViewMode}|{SortMode}|{_scope}|{activeId}|{CollectionSearch}|{CollectionCategoryFilter}|{CollectionOwnershipFilter}|{CollectionIncludeTiered}|{CollectionMinTier}|{totalLoot}|{totalRuns}";

        if (key == _lastCacheKey)
            return;

        _lastCacheKey = key;

        var loot = State.GetLootSnapshot(_scope);
        var runs = State.GetDungeonRunsSnapshot(_scope);
        _runsCount = runs.Count;
        _ownedStatsById = BuildOwnedStatsById(loot);

        var baseFilteredItems = GetFilteredCollectionItems(loot, applySearch: ViewMode != "TROPHY").ToList();
        _overallProgress = UiHelpers.ComputeCollectionProgress(
            GameData.GetAllKnownItems(), loot, CollectionIncludeTiered, CollectionMinTier);

        if (ViewMode == "TROPHY")
        {
            var rawRows = ItemSources.BuildTrophyHall(baseFilteredItems, loot, runs, GameData);
            string q = CollectionSearch.Trim();

            if (!string.IsNullOrEmpty(q))
            {
                var matched = new List<TrophyHallDungeonRow>();
                foreach (var r in rawRows)
                {
                    if (r.DungeonName.Contains(q, StringComparison.OrdinalIgnoreCase))
                    {
                        matched.Add(r);
                    }
                    else
                    {
                        var matchingItems = r.Items.Where(it => it.Meta.Name.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
                        if (matchingItems.Count > 0)
                            matched.Add(r with { Items = matchingItems });
                    }
                }
                rawRows = matched;
            }

            _uncategorizedRow = rawRows.FirstOrDefault(r => r.DungeonName.Equals("Other / Uncategorized", StringComparison.OrdinalIgnoreCase));
            _uncatChunks = _uncategorizedRow != null ? ChunkList(_uncategorizedRow.Items, 16) : new();

            var mapped = rawRows
                .Where(r => !r.DungeonName.Equals("Other / Uncategorized", StringComparison.OrdinalIgnoreCase))
                .ToList();

            _trophyRows = SortMode switch
            {
                "PERCENT" => mapped.OrderByDescending(r => r.CompletionPercent).ThenByDescending(r => r.OwnedCount).ThenByDescending(r => r.Graves).ToList(),
                "COMP" => mapped.OrderByDescending(r => r.Completions).ThenByDescending(r => r.Graves).ThenBy(r => r.DungeonName).ToList(),
                "NAME" => mapped.OrderBy(r => r.DungeonName, StringComparer.OrdinalIgnoreCase).ToList(),
                _ => mapped.OrderByDescending(r => r.Graves).ThenByDescending(r => r.OwnedCount).ThenBy(r => r.DungeonName).ToList()
            };

            var distinctShownIds = _trophyRows.Concat(_uncategorizedRow != null ? [_uncategorizedRow] : [])
                .SelectMany(r => r.Items)
                .Select(i => i.Meta.ItemId)
                .ToHashSet();
            _shownItemCount = distinctShownIds.Count;
            _ownedInView = distinctShownIds.Count(id => _ownedStatsById.ContainsKey(id));
            _flatChunks = new();
        }
        else
        {
            _trophyRows = new();
            _uncategorizedRow = null;
            _uncatChunks = new();
            _flatChunks = ChunkList(baseFilteredItems, 14);
            _shownItemCount = baseFilteredItems.Count;
            _ownedInView = baseFilteredItems.Count(i => _ownedStatsById.ContainsKey(i.ItemId));
        }

        _viewPct = _shownItemCount > 0 ? Math.Round((double)_ownedInView / _shownItemCount * 100.0, 1) : 0.0;
    }

    private static Dictionary<int, (int Count, ItemRarity BestRarity, double BestScore)> BuildOwnedStatsById(IReadOnlyList<LootDropRecord> loot)
    {
        var dict = new Dictionary<int, (int Count, ItemRarity BestRarity, double BestScore)>();
        foreach (var l in loot)
        {
            if (l.ItemId <= 0) continue;
            if (dict.TryGetValue(l.ItemId, out var prev))
            {
                dict[l.ItemId] = (
                    prev.Count + 1,
                    l.Rarity > prev.BestRarity ? l.Rarity : prev.BestRarity,
                    Math.Max(prev.BestScore, l.RarityScore));
            }
            else
            {
                dict[l.ItemId] = (1, l.Rarity, l.RarityScore);
            }
        }
        return dict;
    }

    private IEnumerable<ItemMetadata> GetFilteredCollectionItems(IReadOnlyList<LootDropRecord> loot, bool applySearch = true)
    {
        // Exclude Blueprints & Schematics from Item Collection
        var items = GameData.GetAllKnownItems().Where(i => i.Quality != DropType.BPs);

        if (!CollectionIncludeTiered)
            items = items.Where(i => i.Tier <= 0);
        else
            items = items.Where(i => i.Tier <= 0 || i.Tier >= CollectionMinTier);

        items = CollectionCategoryFilter switch
        {
            "LEGENDARY_WHITE" => items.Where(i => i.Quality == DropType.LegendaryWhite && !i.IsShiny),
            "EVENT_WHITE" => items.Where(i => i.Quality == DropType.EventWhite && !i.IsShiny),
            "REGULAR_WHITE" => items.Where(i => i.Quality == DropType.RegularWhite && !i.IsShiny),
            "ST" => items.Where(i => i.Quality == DropType.ST),
            "SHINY" => items.Where(i => i.IsShiny),
            _ => items
        };

        if (applySearch && !string.IsNullOrWhiteSpace(CollectionSearch))
        {
            string q = CollectionSearch.Trim();
            items = items.Where(i => i.Name.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        if (CollectionOwnershipFilter != "ALL")
        {
            var ownedIds = loot
                .Where(l => l.ItemId > 0)
                .Select(l => l.ItemId)
                .ToHashSet();

            if (CollectionOwnershipFilter == "OWNED")
                items = items.Where(i => ownedIds.Contains(i.ItemId));
            else if (CollectionOwnershipFilter == "MISSING")
                items = items.Where(i => !ownedIds.Contains(i.ItemId));
        }

        return items.OrderByDescending(i => i.IsShiny).ThenBy(i => i.Name);
    }

    private static List<List<T>> ChunkList<T>(IReadOnlyList<T> source, int size)
    {
        var result = new List<List<T>>((source.Count + size - 1) / size);
        for (int i = 0; i < source.Count; i += size)
        {
            int take = Math.Min(size, source.Count - i);
            var chunk = new List<T>(take);
            for (int j = 0; j < take; j++)
                chunk.Add(source[i + j]);
            result.Add(chunk);
        }
        return result;
    }

    private static string GetGravesTierClass(double graves) => graves switch
    {
        >= 9.0 => "graves-exalt",
        >= 7.0 => "graves-high",
        >= 5.0 => "graves-mid",
        _ => "graves-low"
    };
}
