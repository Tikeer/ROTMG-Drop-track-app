@using System.Diagnostics
@inherits StateAwareComponent

@{
    var backups = State.GetBackupFiles();
}

<div class="section-header" style="margin-bottom: 10px;">
    <div class="inline-meta-item" style="gap: 10px;">
        <h2>Backup &amp; Sync</h2>
        <span class="badge-nossnl badge-readonly">Mac ↔ Windows</span>
    </div>
</div>

<div class="safety-grid">
    <!-- DATABASE BACKUPS -->
    <section class="safety-card">
        <div class="safety-card-header">
            <div class="inline-meta-item" style="gap: 8px;">
                <UiIcon Name="shield" Size="17" />
                <h3>Database Backups</h3>
            </div>
            <span class="badge-nossnl badge-readonly">@backups.Count saved</span>
        </div>

        <p class="safety-desc">
            Automatic snapshots run via SQLite <code>VACUUM INTO</code>: one daily backup (last 14 kept) plus an hourly <code>latest</code> snapshot.
        </p>

        <div class="safety-path-box" title="@State.BackupFolder">
            <span>Folder:</span>
            <code>@State.BackupFolder</code>
        </div>

        <div class="safety-btn-row">
            <button type="button" class="btn btn-primary btn-sm inline-meta-item" @onclick="CreateBackup">
                <UiIcon Name="save" Size="14" />
                <span>Create Backup Now</span>
            </button>
            <button type="button" class="btn btn-sm inline-meta-item" @onclick="() => OpenFolder(State.BackupFolder)">
                <UiIcon Name="folder" Size="14" />
                <span>Open Backup Folder</span>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_backupMessage))
        {
            <div class="safety-status @(_backupError ? "is-error" : "is-ok")">@_backupMessage</div>
        }

        <div class="safety-subhead">Recent Snapshots</div>
        @if (backups.Count == 0)
        {
            <div class="safety-empty">No backups yet — the first snapshot is created automatically on the next database save.</div>
        }
        else
        {
            <div class="safety-backup-list">
                @foreach (var f in backups.Take(8))
                {
                    <div class="safety-backup-row">
                        <span class="safety-backup-name" title="@f.Name">@f.Name</span>
                        <span class="safety-backup-meta">@(f.Length / 1024) KB • @f.LastWriteTime.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                }
            </div>
        }

        <div class="safety-note">
            <strong>Restoring:</strong> close the app, copy a snapshot over <code>rotmg_tracker.db</code>, and remove any leftover <code>-wal</code> / <code>-shm</code> files.
        </div>
    </section>

    <!-- HISTORY SYNC BETWEEN COMPUTERS -->
    <section class="safety-card">
        <div class="safety-card-header">
            <div class="inline-meta-item" style="gap: 8px;">
                <UiIcon Name="upload" Size="17" />
                <h3>History Transfer (Mac ↔ Windows)</h3>
            </div>
        </div>

        <ol class="safety-steps">
            <li>On computer A, click <strong>Export History</strong> to write a JSON bundle into <code>exports</code>.</li>
            <li>Copy that JSON file to computer B into its <code>import</code> folder.</li>
            <li>On computer B, click <strong>Import from Folder</strong> — duplicates are skipped, a pre-import backup is taken first, and processed files move to <code>import/done</code>.</li>
        </ol>

        <div class="safety-btn-row">
            <button type="button" class="btn btn-primary btn-sm inline-meta-item" @onclick="Export">
                <UiIcon Name="upload" Size="14" />
                <span>Export History</span>
            </button>
            <button type="button" class="btn btn-sm inline-meta-item" @onclick="() => OpenFolder(State.ExportFolder)">
                <UiIcon Name="folder" Size="14" />
                <span>Open Exports</span>
            </button>
            <button type="button" class="btn btn-sm inline-meta-item" @onclick="Import">
                <UiIcon Name="download" Size="14" />
                <span>Import from Folder</span>
            </button>
            <button type="button" class="btn btn-sm inline-meta-item" @onclick="() => OpenFolder(State.ImportFolder)">
                <UiIcon Name="folder" Size="14" />
                <span>Open Imports</span>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_transferMessage))
        {
            <div class="safety-status @(_transferError ? "is-error" : "is-ok")">@_transferMessage</div>
        }

        <div class="safety-note">
            <strong>Transferred:</strong> drops, dungeon completions, DPS fights, and characters (same linked account only).<br />
            <strong>Local-only (not transferred):</strong> legacy import counters, Dream Set, Daily Quests, and UI settings.
        </div>
    </section>
</div>

@code {
    private string _backupMessage = string.Empty;
    private bool _backupError;
    private string _transferMessage = string.Empty;
    private bool _transferError;

    private void CreateBackup()
    {
        try
        {
            _backupError = false;
            _backupMessage = $"Backup created: {State.CreateBackupNow()}";
        }
        catch (Exception ex)
        {
            _backupError = true;
            _backupMessage = $"Could not create backup: {ex.Message}";
        }
    }

    private void Export()
    {
        try
        {
            _transferError = false;
            _transferMessage = $"Exported: {State.ExportHistory()}";
        }
        catch (Exception ex)
        {
            _transferError = true;
            _transferMessage = $"Export failed: {ex.Message}";
        }
    }

    private void Import()
    {
        try
        {
            _transferError = false;
            _transferMessage = State.ImportHistoryFromFolder().Summary;
        }
        catch (Exception ex)
        {
            _transferError = true;
            _transferMessage = $"Import failed: {ex.Message}";
        }
    }

    private static void OpenFolder(string path)
    {
        try
        {
            Directory.CreateDirectory(path);

            if (OperatingSystem.IsWindows())
                Process.Start(new ProcessStartInfo("explorer.exe", $"\"{path}\"") { UseShellExecute = true });
            else if (OperatingSystem.IsMacOS())
                Process.Start("open", $"\"{path}\"");
            else
                Process.Start("xdg-open", $"\"{path}\"");
        }
        catch
        {
            // No desktop file manager available — path stays visible in UI
        }
    }
}
