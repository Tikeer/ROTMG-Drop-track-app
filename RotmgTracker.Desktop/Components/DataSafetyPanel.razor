@using System.Diagnostics
@inject TrackerStateService State

<div class="section-header">
    <h2>🛡️ Backup & Sync (Mac ↔ Windows)</h2>
</div>

<div class="opening-card" style="margin-bottom: 16px;">
    <div style="padding: 14px 16px;">
        <h3 style="margin: 0 0 8px 0;">Database backups</h3>
        <div style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px;">
            Automatic: one backup per day (state from the start of the day, last 14 kept) plus a "latest" backup refreshed hourly.
            Folder: <code>@State.BackupFolder</code>
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px;">
            <button class="btn" @onclick="CreateBackup">💾 Create backup now</button>
            <button class="btn" @onclick="() => OpenFolder(State.BackupFolder)">📂 Open backup folder</button>
        </div>

        @if (!string.IsNullOrEmpty(BackupMessage))
        {
            <div style="font-size: 0.85rem; margin-bottom: 8px;">@BackupMessage</div>
        }

        @{
            var backups = State.GetBackupFiles();
        }
        @if (backups.Count == 0)
        {
            <div style="color: var(--text-muted); font-size: 0.85rem;">No backups yet (the first one is created on the next database save).</div>
        }
        else
        {
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                @foreach (var f in backups.Take(8))
                {
                    <div>@f.Name — @(f.Length / 1024) KB — @f.LastWriteTime.ToString("yyyy-MM-dd HH:mm")</div>
                }
            </div>
        }

        <div style="margin-top: 10px; font-size: 0.8rem; color: var(--text-muted);">
            Restoring: close the app, copy the chosen file from the backup folder as <code>rotmg_tracker.db</code> (replace the existing one)
            and delete any <code>rotmg_tracker.db-wal</code> / <code>-shm</code> files.
        </div>
    </div>
</div>

<div class="opening-card">
    <div style="padding: 14px 16px;">
        <h3 style="margin: 0 0 8px 0;">History transfer between computers</h3>
        <div style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px;">
            1) On computer A: "Export history" → a JSON file in the exports folder.<br />
            2) Copy the file to computer B (cloud, USB drive) into its import folder..<br />
            3) On computer B: "Import from import folder". Duplicates are skipped, a database backup is made before importing, and imported files are moved to import/done.
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px;">
            <button class="btn" @onclick="Export">📤 Export history</button>
            <button class="btn" @onclick="() => OpenFolder(State.ExportFolder)">📂 Open Exports Folder</button>
            <button class="btn" @onclick="Import">📥 Import from import folder</button>
            <button class="btn" @onclick="() => OpenFolder(State.ImportFolder)">📂 Open Imports Folder</button>
        </div>

        @if (!string.IsNullOrEmpty(TransferMessage))
        {
            <div style="font-size: 0.85rem;">@TransferMessage</div>
        }

        <div style="margin-top: 10px; font-size: 0.8rem; color: var(--text-muted);">
            Transferred: drops, dungeon completions, DPS fights and characters. Not transferred: manual counters (+/−), quest tracker, wishlist, openings.
            Import only works for the same account (the account name in the file must match the linked account).
        </div>
    </div>
</div>

@code {
    private string BackupMessage { get; set; } = string.Empty;
    private string TransferMessage { get; set; } = string.Empty;

    private void CreateBackup()
    {
        try
        {
            BackupMessage = $"Backup created: {State.CreateBackupNow()}";
        }
        catch (Exception ex)
        {
            BackupMessage = $"Could not create backup: {ex.Message}";
        }
    }

    private void Export()
    {
        try
        {
            TransferMessage = $"Exported: {State.ExportHistory()}";
        }
        catch (Exception ex)
        {
            TransferMessage = $"Export failed: {ex.Message}";
        }
    }

    private void Import()
    {
        try
        {
            TransferMessage = State.ImportHistoryFromFolder().Summary;
        }
        catch (Exception ex)
        {
            TransferMessage = $"Import failed: {ex.Message}";
        }
    }

    private static void OpenFolder(string path)
    {
        try
        {
            Directory.CreateDirectory(path);

            if (OperatingSystem.IsWindows())
                Process.Start(new ProcessStartInfo("explorer.exe", $"\"{path}\"") { UseShellExecute = true });
            else if (OperatingSystem.IsMacOS())
                Process.Start("open", $"\"{path}\"");
            else
                Process.Start("xdg-open", $"\"{path}\"");
        }
        catch
        {
            // Brak menedżera plików - ścieżka jest widoczna w interfejsie
        }
    }
}
