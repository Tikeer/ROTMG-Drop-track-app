@inherits StateAwareComponent

<div class="section-header" style="margin-top: 16px;">
    <h2>Best Bag (highest total Rarity Score in one bag)</h2>
</div>

@{
    var bestBag = UiHelpers.GroupByBagInstance(State.GetLootSnapshot(DataScope.AllCharacters))
        .OrderByDescending(g => g.Sum(r => r.RarityScore))
        .FirstOrDefault();
}

@if (bestBag == null || bestBag.Sum(r => r.RarityScore) <= 0)
{
    <div class="empty-state">No bags scored yet.</div>
}
else
{
    var first = bestBag[0];

    <div class="drop-log-row" style="border-left: 4px solid var(--accent-gold);">
        <div class="drop-log-time">
            <div class="inline-meta-item" style="font-weight: 700; color: var(--text-primary);">
                <UiIcon Name="clock" Size="12" />
                <span>@first.DroppedAt.ToString("HH:mm:ss")</span>
            </div>
            <div>@first.DroppedAt.ToString("yyyy-MM-dd") • @first.ServerName</div>
        </div>

        <div class="drop-context-strip">
            <div class="context-sprite-box sprite-tip-host">
                <GameSprite BagObjectType="first.BagObjectType" FallbackBagType="first.PhysicalBag" Size="34" />
                <div class="rotmg-tooltip rotmg-tooltip-sm">
                    <div class="rotmg-tooltip-title">@first.PhysicalBag</div>
                    <div class="rotmg-tooltip-sub">Container 0x@(first.BagObjectType.ToString("X4"))</div>
                </div>
            </div>
            <div class="context-sprite-box sprite-tip-host">
                <GameSprite Class="first.CharacterClass" SkinId="first.CharacterSkinId" Size="32" />
                <div class="rotmg-tooltip rotmg-tooltip-sm">
                    <div class="rotmg-tooltip-title">@first.CharacterName</div>
                    <div class="rotmg-tooltip-sub">Fame: @first.BaseFameAtDrop.ToString("N0")</div>
                </div>
            </div>
            <div class="context-sprite-box sprite-tip-host">
                <GameSprite PortalObjectType="first.DungeonPortalObjectType" DungeonName="@first.DungeonName" Size="32" />
                <div class="rotmg-tooltip rotmg-tooltip-sm">
                    <div class="rotmg-tooltip-title">@first.DungeonName</div>
                    <div class="rotmg-tooltip-sub">@first.GraveDifficulty.ToString("0.#")/10 Graves</div>
                </div>
            </div>
            <div class="context-sprite-box sprite-tip-host">
                <GameSprite BossObjectType="first.BossObjectType" BossName="@first.BossName" Size="34" />
                <div class="rotmg-tooltip rotmg-tooltip-sm">
                    <div class="rotmg-tooltip-title">@first.BossName</div>
                    <div class="rotmg-tooltip-sub">@first.DungeonName</div>
                </div>
            </div>
        </div>

        <div class="drop-items-strip">
            @foreach (var item in bestBag.Where(i => i.RarityScore > 0))
            {
                <ItemSprite ItemId="item.ItemId"
                            ItemName="@item.ItemName"
                            Rarity="item.Rarity"
                            IsShiny="item.IsShiny"
                            DropQuality="item.BagType"
                            RarityScore="item.RarityScore"
                            Size="44" />
            }
        </div>

        <strong style="color: var(--accent-gold); font-size: 1.1rem; white-space: nowrap;">
            @Math.Round(bestBag.Sum(r => r.RarityScore)) pts
        </strong>
    </div>
}
