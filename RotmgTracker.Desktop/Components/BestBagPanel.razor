@inherits StateAwareComponent

@{
    var topBags = UiHelpers.GroupByBagInstance(State.GetLootSnapshot(Scope))
        .Select(g => new { Group = g, TotalScore = g.Sum(r => r.RarityScore) })
        .Where(x => x.TotalScore > 0)
        .OrderByDescending(x => x.TotalScore)
        .Take(5)
        .ToList();
    int rank = 1;
}

<div class="profile-col-header">
    <div>
        <h3 class="profile-col-title">Top 5 Best Bags</h3>
        <span class="profile-col-sub">Highest total score per bag</span>
    </div>
</div>

@if (topBags.Count == 0)
{
    <div class="empty-state" style="padding: 20px 14px; font-size: 0.84rem;">
        No scored bags in this scope yet.
    </div>
}
else
{
    <div class="profile-col-list">
        @foreach (var entry in topBags)
        {
            var bag = entry.Group;
            var first = bag[0];

            <div class="best-bag-card @(rank == 1 ? "is-best" : "")">
                <div class="best-bag-head">
                    <div class="inline-meta-item" style="gap: 6px; min-width: 0; flex: 1;">
                        <span class="top-drop-rank">#@rank</span>
                        <GameSprite BagObjectType="first.BagObjectType" FallbackBagType="first.PhysicalBag" Size="22" Title="@first.PhysicalBag.ToString()" />
                        <GameSprite PortalObjectType="first.DungeonPortalObjectType" DungeonName="@first.DungeonName" Size="20" Title="@first.DungeonName" />
                        @if (!string.IsNullOrWhiteSpace(first.BossName) && first.BossObjectType > 0)
                        {
                            <GameSprite BossObjectType="first.BossObjectType" BossName="@first.BossName" Size="22" Title="@first.BossName" />
                        }
                        <div class="best-bag-meta">
                            <span class="best-bag-dungeon" title="@first.DungeonName">@first.DungeonName</span>
                            <span class="best-bag-date">@first.DroppedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>

                    <strong class="best-bag-pts">@Math.Round(entry.TotalScore) pts</strong>
                </div>

                <div class="best-bag-items">
                    @foreach (var item in bag.Where(i => i.RarityScore > 0).OrderByDescending(i => i.RarityScore))
                    {
                        <ItemSprite ItemId="item.ItemId"
                                    ItemName="@item.ItemName"
                                    Rarity="item.Rarity"
                                    IsShiny="item.IsShiny"
                                    DropQuality="item.BagType"
                                    RarityScore="item.RarityScore"
                                    Size="38" />
                    }
                </div>
            </div>
            rank++;
        }
    </div>
}

@code {
    [Parameter] public DataScope Scope { get; set; } = DataScope.ActiveCharacter;
}
