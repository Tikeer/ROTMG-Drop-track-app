@inherits StateAwareComponent
@inject RotmgSnifferService Sniffer
@inject GameDataService GameData
@inject UiSettings UiSettings

<div class="section-header" style="margin-bottom: 10px;">
    <h2>Settings</h2>
    <div class="profile-scope-toggle" role="group" aria-label="Settings section">
        <button type="button"
                class="scope-toggle-btn @(_subTab == "general" ? "active" : "")"
                @onclick='() => _subTab = "general"'>
            General &amp; Sniffer
        </button>
        <button type="button"
                class="scope-toggle-btn @(_subTab == "backup" ? "active" : "")"
                @onclick='() => _subTab = "backup"'>
            Backup &amp; Sync
        </button>
    </div>
</div>

@if (_subTab == "backup")
{
    <DataSafetyPanel />
}
else
{
<div class="settings-grid">
    <!-- GENERAL & SEASON -->
    <div class="settings-card">
        <h3 class="settings-card-title">General &amp; Season</h3>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">Current Season</div>
                <div class="settings-row-desc">Applied automatically to newly created seasonal characters. Existing characters keep their original season tag.</div>
            </div>
            <DarkSelect Value="@State.CurrentSeasonTag"
                        ValueChanged="OnSeasonValueChanged"
                        Options="@SeasonOptions()"
                        MinWidth="104px"
                        AlignRight="true"
                        Title="Default season for new characters" />
        </div>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">Linked Account</div>
                <div class="settings-row-desc">
                    @if (!string.IsNullOrEmpty(State.LinkedAccountName))
                    {
                        <span>Connected to <strong>@State.LinkedAccountName</strong>. Used for automatic character detection and history import verification.</span>
                    }
                    else
                    {
                        <span>No account linked yet. Enter the Nexus in-game with the sniffer running to link your account.</span>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(State.LinkedAccountName))
            {
                <button class="btn btn-danger btn-sm" @onclick="State.UnlinkAccount">Unlink Account</button>
            }
        </div>
    </div>

    <!-- PASSIVE SNIFFER -->
    <div class="settings-card">
        <h3 class="settings-card-title">Passive Sniffer</h3>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">
                    <span class="status-diode @(Sniffer.IsListening ? "online" : "offline")" style="margin-right: 8px;"></span>
                    @(Sniffer.IsListening ? "Listening (TCP:2050)" : "Sniffer Stopped")
                </div>
                <div class="settings-row-desc">@Sniffer.StatusMessage • Packets captured: <strong>@Sniffer.PacketsCaptured.ToString("N0")</strong></div>
            </div>
            <button class="btn btn-sm @(Sniffer.IsListening ? "" : "btn-primary")" @onclick="ToggleSniffer">
                @(Sniffer.IsListening ? "Stop Sniffer" : "Start Sniffer")
            </button>
        </div>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">Packet Capture Log</div>
                <div class="settings-row-desc">
                    @if (Sniffer.CaptureEnabled)
                    {
                        <span>Recording diagnostic capture to <code>@Sniffer.Capture.FilePath</code></span>
                    }
                    else
                    {
                        <span>Records decoded protocol events for troubleshooting. Capture files contain account metadata and stay local.</span>
                    }
                </div>
            </div>
            <button class="btn btn-sm @(Sniffer.CaptureEnabled ? "btn-danger" : "")" @onclick="ToggleCapture">
                @(Sniffer.CaptureEnabled ? "Stop Capture" : "Start Capture")
            </button>
        </div>

        <div class="settings-row settings-row-stack">
            <div class="settings-row-info" style="width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 10px;">
                <div>
                    <div class="settings-row-label">Loot Bag Tracking</div>
                    <div class="settings-row-desc">Choose which bag colors are saved to Loot History. Boss kills, DPS, dungeon completions, and Tinkerer marks are always tracked.</div>
                </div>
                <button type="button" class="btn btn-sm" @onclick="UiSettings.ResetTrackedBags">Enable All</button>
            </div>
            <div class="bag-filter-grid">
                @foreach (var bag in TrackableBagOptions)
                {
                    bool enabled = UiSettings.IsBagTracked(bag.Bag);
                    <button type="button"
                            class="bag-filter-chip @(enabled ? "is-on" : "is-off")"
                            title="@(enabled ? "Click to stop saving drops from this bag" : "Click to start saving drops from this bag")"
                            @onclick="() => ToggleBag(bag.Bag)">
                        <GameSprite BagObjectType="@bag.ObjectType" FallbackBagType="@bag.Bag" Size="20" />
                        <span>@bag.Label</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- GAME DATA & CATALOGS -->
    <div class="settings-card">
        <h3 class="settings-card-title">Game Data &amp; Catalogs</h3>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">Extracted Catalogs</div>
                <div class="settings-row-desc">
                    Items: <strong>@GameData.GetAllKnownItems().Count</strong>
                    (Shinies: <strong>@GameData.GetAllKnownItems().Count(i => i.IsShiny)</strong>) •
                    Portals: <strong>@GameData.GetAllKnownDungeons().Count</strong> •
                    Bosses: <strong>@GameData.GetAllKnownBosses().Count</strong> •
                    Marks: <strong>@GameData.GetAllKnownMarks().Count</strong>
                </div>
                <div class="settings-row-desc" style="margin-top: 4px;">Status: @GameData.ExtractionStatus</div>
                @if (!string.IsNullOrEmpty(RescanMessage))
                {
                    <div class="settings-row-desc" style="margin-top: 4px; color: var(--accent-white);">@RescanMessage</div>
                }
            </div>
            <button class="btn btn-primary btn-sm" disabled="@IsScanning" @onclick="RescanGameFilesAsync">
                @(IsScanning ? "Rescanning..." : "Rescan Game Files")
            </button>
        </div>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">Sprite Atlas</div>
                <div class="settings-row-desc">
                    @Sprites.StatusMessage<br />
                    Cache folder: <code>@Sprites.SpritesFolder</code>
                </div>
                @if (Sprites.IsReady)
                {
                    <div class="sprite-preview-strip">
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="28" Title="White Bag" />
                        <GameSprite BagObjectType="0x050E" FallbackBagType="BagType.GoldBag" Size="28" Title="Gold Bag" />
                        <GameSprite BagObjectType="0x050F" FallbackBagType="BagType.OrangeBag" Size="28" Title="Orange Bag" />
                        <GameSprite BagObjectType="0x06AC" FallbackBagType="BagType.RedBag" Size="28" Title="Red Bag" />
                        <GameSprite UiSpriteName="material_rare" Size="24" Title="Rare Forge Material" />
                        <GameSprite UiSpriteName="material_legendary" Size="24" Title="Legendary Forge Material" />
                        <GameSprite TextureFile="lofiEnvironment" TextureIndex="0x7b" Size="24" Title="Realm Portal" />
                        <ItemSprite ItemId="2505" Rarity="ItemRarity.Divine" Size="34" ShowTooltip="false" />
                        <ItemSprite ItemId="1210" IsShiny="true" Rarity="ItemRarity.Divine" Size="34" ShowTooltip="false" />
                    </div>
                }
            </div>
            <button class="btn btn-sm" disabled="@(Sprites.IsBuilding || IsScanning)" @onclick="RebuildSpritesAsync">
                @(Sprites.IsBuilding ? "Building..." : "Rebuild Sprite Atlas")
            </button>
        </div>
    </div>

    <!-- DEVELOPER / DEBUG -->
    <div class="settings-card">
        <h3 class="settings-card-title">Debug &amp; Developer Tools</h3>

        <div class="settings-row">
            <div class="settings-row-info">
                <div class="settings-row-label">Developer Mode</div>
                <div class="settings-row-desc">Reveals diagnostic actions (DPS simulator, manual fight archiving, legacy dungeon counter view).</div>
            </div>
            <label class="checkbox-label">
                <input type="checkbox" checked="@UiSettings.DebugMode" @onchange="OnDebugModeChanged" />
                Enabled
            </label>
        </div>

        @if (UiSettings.DebugMode)
        {
            <div class="settings-row">
                <div class="settings-row-info">
                    <div class="settings-row-label">Test Boss DPS</div>
                    <div class="settings-row-desc">Simulates incoming DAMAGE packets for testing the Live DPS meter.</div>
                </div>
                <button class="btn btn-sm" @onclick="SimulateBossDps">Test Boss DPS</button>
            </div>

            <div class="settings-row">
                <div class="settings-row-info">
                    <div class="settings-row-label">Legacy Dungeon Counters</div>
                    <div class="settings-row-desc">Open the hidden Dungeon Completion Counter view.</div>
                </div>
                <button class="btn btn-sm" @onclick='() => OnSetTab.InvokeAsync("counters")'>Open Counters</button>
            </div>

            <div class="settings-row">
                <div class="settings-row-info">
                    <div class="settings-row-label">Diagnostics</div>
                    <div class="settings-row-desc">
                        AppData: <code>@State.AppDataFolder</code><br />
                        Loot records: <strong>@State.Data.LootHistory.Count</strong> •
                        Dungeon runs: <strong>@State.Data.DungeonRuns.Count</strong> •
                        Combat fights: <strong>@State.Data.CombatHistory.Count</strong>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
}

@code {
    [Parameter] public EventCallback<string> OnSetTab { get; set; }

    private static readonly (BagType Bag, int ObjectType, string Label)[] TrackableBagOptions =
    [
        (BagType.WhiteBag,  0x050C, "White"),
        (BagType.OrangeBag, 0x050F, "Orange (ST)"),
        (BagType.RedBag,    0x06AC, "Red (Tops)"),
        (BagType.GoldBag,   0x050E, "Gold (BP)"),
        (BagType.BlueBag,   0x050B, "Blue"),
        (BagType.CyanBag,   0x0509, "Cyan"),
        (BagType.EggBag,    0x0508, "Egg"),
        (BagType.PurpleBag, 0x0507, "Purple")
    ];

    private string _subTab = "general";

    private void ToggleBag(BagType bag)
    {
        UiSettings.SetBagTracked(bag, !UiSettings.IsBagTracked(bag));
    }
    private bool IsScanning => GameData.IsRescanning || _rescanInProgress;
    private bool _rescanInProgress;
    private string RescanMessage { get; set; } = string.Empty;

    private void OnSeasonValueChanged(string season)
    {
        if (!string.IsNullOrWhiteSpace(season))
            State.SetCurrentSeason(season);
    }

    private List<DarkSelectOption> SeasonOptions()
    {
        int cur = int.TryParse(State.CurrentSeasonTag.AsSpan(1), out int n) ? n : 31;
        int first = Math.Min(cur, 31);
        int last = Math.Max(cur, 31) + 3;

        var list = new List<DarkSelectOption>();
        for (int i = first; i <= last; i++)
        {
            string tag = $"S{i}";
            list.Add(new DarkSelectOption(tag, tag));
        }
        return list;
    }

    private void ToggleSniffer()
    {
        if (Sniffer.IsListening) Sniffer.StopListening();
        else Sniffer.StartListening();
        StateHasChanged();
    }

    private void ToggleCapture()
    {
        Sniffer.ToggleCapture();
        StateHasChanged();
    }

    private async Task RescanGameFilesAsync()
    {
        if (IsScanning) return;
        _rescanInProgress = true;
        RescanMessage = "Scanning RotMG resources.assets in background...";
        StateHasChanged();

        try
        {
            int count = await GameData.RescanGameFilesAsync();
            if (count > 0)
            {
                RescanMessage = $"Rescan completed: {count} items loaded. Rebuilding sprite atlas...";
                StateHasChanged();
                await Sprites.RebuildAsync();
                RescanMessage = $"Rescan completed: {count} items loaded ({Sprites.SpriteCount} sprites packed).";
            }
            else
            {
                RescanMessage = GameData.ExtractionStatus;
            }
        }
        catch (Exception ex)
        {
            RescanMessage = $"Rescan failed: {ex.Message}";
        }
        finally
        {
            _rescanInProgress = false;
            StateHasChanged();
        }
    }

    private async Task RebuildSpritesAsync()
    {
        if (Sprites.IsBuilding) return;
        await Sprites.RebuildAsync();
        StateHasChanged();
    }

    private void OnDebugModeChanged(ChangeEventArgs e)
    {
        UiSettings.DebugMode = e.Value is true;
    }

    private void SimulateBossDps()
    {
        Sniffer.SimulateDungeonDpsFight();
        OnSetTab.InvokeAsync("dps");
    }
}
