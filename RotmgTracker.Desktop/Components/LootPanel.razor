@inherits StateAwareComponent

<div class="section-header" style="margin-bottom: 10px;">
    <h2>Loot History</h2>
</div>

@{
    var scopedLoot = State.GetLootSnapshot(_filter.Scope);
    var allGroups = UiHelpers.GroupByBagInstance(_filter.Apply(scopedLoot));
    var visibleGroups = allGroups.Take(_visibleBags).ToList();
    int totalDrops = allGroups.Sum(g => g.Count);
}

<LootFilterBar Filter="_filter"
               SourceLoot="scopedLoot"
               ActiveCharacterTitle="@State.ActiveCharacter.FormattedTitle"
               ShowPageSize="true"
               PageSize="_pageSize"
               PageSizeChanged="OnPageSizeChanged"
               OnChanged="OnFiltersChanged" />

<div class="feed-meta-row">
    <span>
        Showing <strong>@visibleGroups.Count</strong> of <strong>@allGroups.Count</strong> bags
        (<strong>@totalDrops</strong> items match)
    </span>
</div>

@if (allGroups.Count == 0)
{
    <div class="empty-state">No bag drops match the current filters.</div>
}
else
{
    <div class="quest-list">
        @foreach (var bagGroup in visibleGroups)
        {
            <BagDropRow BagGroup="bagGroup"
                        AllowRemove="true"
                        OnRemoveItem="HandleRemoveItem"
                        OnOpenFight="OnOpenFight" />
        }
    </div>

    @if (visibleGroups.Count < allGroups.Count)
    {
        <div style="display: flex; justify-content: center; margin: 14px 0;">
            <button type="button" class="btn" @onclick="LoadMore">
                Load @_pageSize more (@(allGroups.Count - visibleGroups.Count) left)
            </button>
        </div>
    }
}

@code {
    [Parameter] public EventCallback<Guid> OnOpenFight { get; set; }

    private const int DefaultPageSize = 100;
    private int _pageSize = DefaultPageSize;
    private int _visibleBags = DefaultPageSize;

    // D7: Loot History defaults to All Characters and shows full history including potions/junk
    private readonly LootFilterState _filter = new()
    {
        Scope = DataScope.AllCharacters,
        ShowOther = true
    };

    private void OnFiltersChanged()
    {
        _visibleBags = _pageSize;
    }

    private void OnPageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _visibleBags = newSize;
    }

    private void LoadMore() => _visibleBags += _pageSize;

    private void HandleRemoveItem(Guid id) => State.RemoveLootRecord(id);
}
