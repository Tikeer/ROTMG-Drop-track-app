@inherits StateAwareComponent

<div class="section-header">
    <h2>@State.ActiveCharacter.FormattedTitle — Drop Counters</h2>
    <div style="display: flex; gap: 10px; align-items: center;">
        <span class="badge-nossnl badge-readonly inline-meta-item">
            <GameSprite PortalObjectType="State.CurrentDungeonPortalType" DungeonName="@State.CurrentDungeonName" Size="18" />
            <span>@State.CurrentDungeonName</span>
            @if (State.CurrentDungeonGraves > 0)
            {
                <span class="graves-inline">(@State.CurrentDungeonGraves.ToString("0.#")/10 <UiIcon Name="skull" Size="12" />)</span>
            }
        </span>
        <span style="color: var(--text-muted); font-size: 0.9rem;">
            Total Drops: <strong style="color: var(--accent-gold);">@State.ActiveCharacter.TotalDrops</strong>
        </span>
    </div>
</div>

<!-- COMPACT SPRITE + COUNT CARDS (tooltip on hover, no dots, no UT) -->
<div class="counter-grid-compact">
    @foreach (var dropType in DisplayDropTypes)
    {
        int val = State.ActiveCharacter.Drops.GetValueOrDefault(dropType);
        string label = UiHelpers.FormatDropType(dropType);

        <div class="counter-card-compact sprite-tip-host">
            <div class="counter-icon-box">
                @switch (dropType)
                {
                    case DropType.RegularWhite:
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="34" />
                        <span class="counter-sub-badge">
                            <GameSprite UiSpriteName="material_rare" Size="18" />
                        </span>
                        break;

                    case DropType.LegendaryWhite:
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="34" />
                        <span class="counter-sub-badge">
                            <GameSprite UiSpriteName="material_legendary" Size="18" />
                        </span>
                        break;

                    case DropType.EventWhite:
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="34" />
                        <span class="counter-sub-badge">
                            <GameSprite TextureFile="lofiEnvironment" TextureIndex="0x7b" Size="18" />
                        </span>
                        break;

                    case DropType.ST:
                        <GameSprite BagObjectType="0x050F" FallbackBagType="BagType.OrangeBag" Size="34" />
                        break;

                    case DropType.BPs:
                        <GameSprite BagObjectType="0x050E" FallbackBagType="BagType.GoldBag" Size="34" />
                        break;

                    case DropType.Tops:
                        <GameSprite BagObjectType="0x06AC" FallbackBagType="BagType.RedBag" Size="34" />
                        break;

                    case DropType.DivineGoodItem:
                        <ItemSprite ItemId="2505" Rarity="ItemRarity.Divine" Size="40" ShowTooltip="false" />
                        break;

                    case DropType.Shiny:
                        <ItemSprite ItemId="1210" IsShiny="true" Size="40" ShowTooltip="false" />
                        break;

                    case DropType.Shivine:
                        <ItemSprite ItemId="1210" IsShiny="true" Rarity="ItemRarity.Divine" Size="40" ShowTooltip="false" />
                        break;
                }
            </div>
            <div class="counter-value-compact">@val</div>

            <div class="rotmg-tooltip rotmg-tooltip-sm">
                <div class="rotmg-tooltip-title">@label</div>
                <div class="rotmg-tooltip-sub">@val recorded on @State.ActiveCharacter.Class #@State.ActiveCharacter.ClassSlotNumber</div>
            </div>
        </div>
    }
</div>

<div class="section-header" style="margin-top: 8px;">
    <h2>Recent Bag Drops</h2>
    <button class="btn btn-sm" @onclick='() => OnSetTab.InvokeAsync("loot")'>View Full Loot History →</button>
</div>

@{
    var recentBagGroups = UiHelpers.GroupByBagInstance(State.GetLootSnapshot(DataScope.AllCharacters).Where(l => l.BagType != DropType.Other).Take(16));
}

@if (recentBagGroups.Count == 0)
{
    <div class="empty-state">No bag drops recorded yet.</div>
}
else
{
    <div class="quest-list">
        @foreach (var bagGroup in recentBagGroups)
        {
            var first = bagGroup[0];
            var bestItem = bagGroup.OrderByDescending(i => i.RarityScore).First();
            <div class="drop-log-row" style="border-left: 4px solid @UiHelpers.GetRarityBorderColor(bestItem.Rarity, bestItem.IsShiny);">
                <div class="drop-log-time">
                    <div class="inline-meta-item" style="font-weight: 700; color: var(--text-primary);">
                        <UiIcon Name="clock" Size="12" />
                        <span>@first.DroppedAt.ToString("HH:mm:ss")</span>
                    </div>
                    <div>@first.DroppedAt.ToString("yyyy-MM-dd") • @first.ServerName</div>
                </div>

                <div class="drop-context-strip">
                    <div class="context-sprite-box sprite-tip-host">
                        <GameSprite BagObjectType="first.BagObjectType" FallbackBagType="first.PhysicalBag" Size="32" />
                        <div class="rotmg-tooltip rotmg-tooltip-sm">
                            <div class="rotmg-tooltip-title">@first.PhysicalBag</div>
                            <div class="rotmg-tooltip-sub">Container 0x@(first.BagObjectType.ToString("X4"))</div>
                        </div>
                    </div>

                    <div class="context-sprite-box sprite-tip-host">
                        <GameSprite Class="first.CharacterClass" SkinId="first.CharacterSkinId" Size="30" />
                        <div class="rotmg-tooltip rotmg-tooltip-sm">
                            <div class="rotmg-tooltip-title">@first.CharacterName</div>
                            <div class="rotmg-tooltip-sub">Fame: @first.BaseFameAtDrop.ToString("N0")</div>
                        </div>
                    </div>

                    <div class="context-sprite-box sprite-tip-host">
                        <GameSprite PortalObjectType="first.DungeonPortalObjectType" DungeonName="@first.DungeonName" Size="30" />
                        <div class="rotmg-tooltip rotmg-tooltip-sm">
                            <div class="rotmg-tooltip-title">@first.DungeonName</div>
                            <div class="rotmg-tooltip-sub">@first.GraveDifficulty.ToString("0.#")/10 Graves</div>
                        </div>
                    </div>

                    <div class="context-sprite-box sprite-tip-host">
                        <GameSprite BossObjectType="first.BossObjectType" BossName="@first.BossName" Size="32" />
                        <div class="rotmg-tooltip rotmg-tooltip-sm">
                            <div class="rotmg-tooltip-title">@first.BossName</div>
                            <div class="rotmg-tooltip-sub">@first.DungeonName</div>
                        </div>
                    </div>
                </div>

                <div class="drop-items-strip">
                    @foreach (var item in bagGroup)
                    {
                        <ItemSprite ItemId="item.ItemId"
                                    ItemName="@item.ItemName"
                                    Rarity="item.Rarity"
                                    IsShiny="item.IsShiny"
                                    DropQuality="item.BagType"
                                    RarityScore="item.RarityScore"
                                    Size="42" />
                    }
                </div>

                @if (first.CombatSessionId.HasValue)
                {
                    <button class="btn btn-sm inline-meta-item" style="border-color: var(--accent-gold); color: var(--accent-gold);"
                            title="View Fight DPS"
                            @onclick="() => OnOpenFight.InvokeAsync(first.CombatSessionId.Value)">
                        <UiIcon Name="sword" Size="14" />
                        <span>DPS</span>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public EventCallback<string> OnSetTab { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenFight { get; set; }

    private static readonly DropType[] DisplayDropTypes =
    [
        DropType.RegularWhite,
        DropType.LegendaryWhite,
        DropType.EventWhite,
        DropType.ST,
        DropType.BPs,
        DropType.Tops,
        DropType.DivineGoodItem,
        DropType.Shiny,
        DropType.Shivine
    ];
}
