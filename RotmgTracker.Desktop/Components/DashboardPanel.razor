@inherits StateAwareComponent
@inject RotmgSnifferService Sniffer

<div class="section-header" style="margin-bottom: 10px;">
    <div class="inline-meta-item" style="gap: 10px;">
        <h2>Live Feed</h2>
        @if (Sniffer.IsListening)
        {
            <span class="live-badge">
                <span class="live-dot"></span>
                LIVE
            </span>
        }
        <span class="badge-nossnl badge-readonly inline-meta-item">
            <GameSprite PortalObjectType="State.CurrentDungeonPortalType" DungeonName="@State.CurrentDungeonName" Size="17" />
            <span>@State.CurrentDungeonName</span>
            @if (State.CurrentDungeonGraves > 0)
            {
                <span class="graves-inline">(@State.CurrentDungeonGraves.ToString("0.#")/10 <UiIcon Name="skull" Size="11" />)</span>
            }
        </span>
    </div>

    <div style="display: flex; gap: 12px; align-items: center;">
        <span style="color: var(--text-muted); font-size: 0.86rem;">
            @State.ActiveCharacter.Class #@State.ActiveCharacter.ClassSlotNumber Total:
            <strong style="color: var(--accent-gold);">@State.ActiveCharacter.TotalDrops</strong>
        </span>
        <button type="button" class="btn btn-sm" @onclick='() => OnSetTab.InvokeAsync("loot")'>Full History →</button>
    </div>
</div>

<!-- COMPACT INTERACTIVE SPRITE + COUNT CARDS (click any card to filter Live Feed below) -->
<div class="counter-grid-compact">
    @foreach (var dropType in DisplayDropTypes)
    {
        int val = State.ActiveCharacter.Drops.GetValueOrDefault(dropType);
        string label = UiHelpers.FormatDropType(dropType);
        bool isActiveFilter = _filter.Quality == dropType;

        <button type="button"
                class="counter-card-compact sprite-tip-host @(isActiveFilter ? "is-filter-active" : "")"
                @onclick="() => ToggleQualityFilter(dropType)">
            <div class="counter-icon-box">
                @switch (dropType)
                {
                    case DropType.RegularWhite:
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="34" />
                        <span class="counter-sub-badge">
                            <GameSprite UiSpriteName="material_rare" Size="18" />
                        </span>
                        break;

                    case DropType.LegendaryWhite:
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="34" />
                        <span class="counter-sub-badge">
                            <GameSprite UiSpriteName="material_legendary" Size="18" />
                        </span>
                        break;

                    case DropType.EventWhite:
                        <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="34" />
                        <span class="counter-sub-badge">
                            <GameSprite TextureFile="lofiEnvironment" TextureIndex="0x7b" Size="18" />
                        </span>
                        break;

                    case DropType.ST:
                        <GameSprite BagObjectType="0x050F" FallbackBagType="BagType.OrangeBag" Size="34" />
                        break;

                    case DropType.BPs:
                        <GameSprite BagObjectType="0x050E" FallbackBagType="BagType.GoldBag" Size="34" />
                        break;

                    case DropType.Tops:
                        <GameSprite BagObjectType="0x06AC" FallbackBagType="BagType.RedBag" Size="34" />
                        break;

                    case DropType.DivineGoodItem:
                        <ItemSprite ItemId="2505" Rarity="ItemRarity.Divine" Size="40" ShowTooltip="false" />
                        break;

                    case DropType.Shiny:
                        <ItemSprite ItemId="1210" IsShiny="true" Size="40" ShowTooltip="false" />
                        break;

                    case DropType.Shivine:
                        <ItemSprite ItemId="1210" IsShiny="true" Rarity="ItemRarity.Divine" Size="40" ShowTooltip="false" />
                        break;
                }
            </div>
            <div class="counter-value-compact">@val</div>

            <div class="rotmg-tooltip rotmg-tooltip-sm">
                <div class="rotmg-tooltip-title">@label</div>
                <div class="rotmg-tooltip-sub">@val on @State.ActiveCharacter.Class #@State.ActiveCharacter.ClassSlotNumber • Click to @(isActiveFilter ? "clear filter" : "filter feed")</div>
            </div>
        </button>
    }
</div>

@{
    var scopedLoot = State.GetLootSnapshot(_filter.Scope);
    var allGroups = UiHelpers.GroupByBagInstance(_filter.Apply(scopedLoot));
    var visibleGroups = allGroups.Take(_visibleBags).ToList();
    int matchedItems = allGroups.Sum(g => g.Count);
}

<LootFilterBar Filter="_filter"
               SourceLoot="scopedLoot"
               ActiveCharacterTitle="@State.ActiveCharacter.FormattedTitle"
               OnChanged="OnFiltersChanged" />

<div class="feed-meta-row">
    <span>
        Showing <strong>@visibleGroups.Count</strong> of <strong>@allGroups.Count</strong> bags
        (<strong>@matchedItems</strong> items)
    </span>
    @if (_filter.Quality.HasValue)
    {
        <span class="feed-active-chip">
            Filter: @UiHelpers.FormatDropType(_filter.Quality.Value)
            <button type="button" @onclick="() => ToggleQualityFilter(_filter.Quality.Value)">✕</button>
        </span>
    }
</div>

@if (allGroups.Count == 0)
{
    <div class="empty-state">
        @(_filter.HasActiveFilters ? "No drops match the active Live Feed filters." : "No bag drops recorded yet.")
    </div>
}
else
{
    <div class="quest-list feed-list-compact">
        @foreach (var bagGroup in visibleGroups)
        {
            <BagDropRow BagGroup="bagGroup"
                        Compact="true"
                        OnOpenFight="OnOpenFight" />
        }
    </div>

    @if (visibleGroups.Count < allGroups.Count)
    {
        <div style="display: flex; justify-content: center; gap: 10px; margin: 10px 0;">
            <button type="button" class="btn btn-sm" @onclick="LoadMore">
                Load @FeedStep more (@(allGroups.Count - visibleGroups.Count) left)
            </button>
            <button type="button" class="btn btn-sm" @onclick='() => OnSetTab.InvokeAsync("loot")'>
                Open Full Loot History →
            </button>
        </div>
    }
}

@code {
    [Parameter] public EventCallback<string> OnSetTab { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenFight { get; set; }

    private const int FeedStep = 25;
    private int _visibleBags = FeedStep;

    private readonly LootFilterState _filter = new()
    {
        Scope = DataScope.AllCharacters,
        ShowOther = false
    };

    private static readonly DropType[] DisplayDropTypes =
    [
        DropType.RegularWhite,
        DropType.LegendaryWhite,
        DropType.EventWhite,
        DropType.ST,
        DropType.BPs,
        DropType.Tops,
        DropType.DivineGoodItem,
        DropType.Shiny,
        DropType.Shivine
    ];

    private void ToggleQualityFilter(DropType quality)
    {
        _filter.Quality = _filter.Quality == quality ? null : quality;
        _visibleBags = FeedStep;
    }

    private void OnFiltersChanged()
    {
        _visibleBags = FeedStep;
    }

    private void LoadMore() => _visibleBags += FeedStep;
}
