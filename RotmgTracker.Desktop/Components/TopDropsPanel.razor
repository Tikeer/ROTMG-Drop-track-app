@inherits StateAwareComponent

<div class="section-header" style="margin-top: 16px;">
    <h2>🏅 Top 10 Drops (by Rarity Score)</h2>
</div>

@{
    var topDrops = State.Data.LootHistory
        .Where(l => l.BagType != DropType.Other)
        .OrderByDescending(l => l.RarityScore)
        .Take(10)
        .ToList();
    int rank = 1;
}

@if (topDrops.Count == 0)
{
    <div class="empty-state">No scored drops yet. Your best drops will rank here automatically!</div>
}
else
{
    <div class="quest-list">
        @foreach (var drop in topDrops)
        {
            <div class="quest-row" style="flex-wrap: wrap; gap: 14px; border-left: 4px solid @UiHelpers.GetRarityBorderColor(drop.Rarity, drop.IsShiny);">
                <span style="color: var(--text-muted); font-weight: 700; min-width: 28px;">#@rank</span>
                <div style="min-width: 240px;">
                    <strong style="color: @(drop.IsShiny ? "#f472b6" : "var(--accent-white)");">
                        @(drop.IsShiny ? "✨ " : "")@drop.ItemName
                    </strong>
                    <span style="font-size: 0.75rem; color: #c084fc; margin-left: 6px;">
                        [@drop.Rarity • @drop.EnchantmentSlots slots • @UiHelpers.FormatDropType(drop.BagType)]
                    </span>
                </div>
                <div style="flex: 1; font-size: 0.78rem; color: var(--text-muted);">
                    📍 @drop.DungeonName • 🧙 @drop.CharacterName • 🕒 @drop.DroppedAt.ToString("yyyy-MM-dd HH:mm")
                </div>
                <strong style="color: var(--accent-gold); min-width: 90px; text-align: right;">@drop.RarityScore pts</strong>
            </div>
            rank++;
        }
    </div>
}