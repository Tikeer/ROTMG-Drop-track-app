@inherits StateAwareComponent

@{
    var allTop = State.GetLootSnapshot(Scope)
        .Where(l => l.BagType != DropType.Other)
        .OrderByDescending(l => l.RarityScore)
        .Take(10)
        .ToList();
    int limit = _showTen ? 10 : 5;
    var topDrops = allTop.Take(limit).ToList();
    int rank = 1;
}

<div class="profile-col-header">
    <div>
        <h3 class="profile-col-title">Top @limit Drops</h3>
        <span class="profile-col-sub">Ranked by Rarity Score</span>
    </div>
    @if (allTop.Count > 5)
    {
        <button type="button" class="btn btn-sm" @onclick="() => _showTen = !_showTen">
            @(_showTen ? "Show Top 5" : "Show Top 10")
        </button>
    }
</div>

@if (topDrops.Count == 0)
{
    <div class="empty-state" style="padding: 20px 14px; font-size: 0.84rem;">
        No scored drops in this scope yet.
    </div>
}
else
{
    <div class="profile-col-list">
        @foreach (var drop in topDrops)
        {
            <div class="top-drop-card" style="border-left: 3px solid @UiHelpers.GetRarityBorderColor(drop.Rarity, drop.IsShiny);">
                <span class="top-drop-rank">#@rank</span>

                <ItemSprite ItemId="drop.ItemId"
                            ItemName="@drop.ItemName"
                            Rarity="drop.Rarity"
                            IsShiny="drop.IsShiny"
                            DropQuality="drop.BagType"
                            RarityScore="drop.RarityScore"
                            Enchantments="@drop.Enchantments"
                            ExtraMeta="@($"{drop.DungeonName} • {drop.DroppedAt:yyyy-MM-dd HH:mm}")"
                            Size="36" />

                <div class="top-drop-info">
                    <div class="top-drop-name-row">
                        <strong class="top-drop-name" style="color: @(drop.IsShiny ? "#f472b6" : "var(--text-primary)");" title="@drop.ItemName">
                            @drop.ItemName
                        </strong>
                        @if (drop.IsShiny)
                        {
                            <span class="shiny-pill">SHINY</span>
                        }
                    </div>
                    <div class="top-drop-meta">
                        <span class="rarity-text-@drop.Rarity.ToString().ToLowerInvariant()">@drop.Rarity</span>
                        <span>•</span>
                        <GameSprite PortalObjectType="drop.DungeonPortalObjectType" DungeonName="@drop.DungeonName" Size="14" Title="@drop.DungeonName" />
                        <span class="top-drop-dungeon" title="@drop.DungeonName">@drop.DungeonName</span>
                        @if (Scope == DataScope.AllCharacters)
                        {
                            <GameSprite Class="drop.CharacterClass" SkinId="drop.CharacterSkinId" Size="14" Title="@drop.CharacterName" />
                        }
                    </div>
                </div>

                <strong class="top-drop-pts">@Math.Round(drop.RarityScore)</strong>
            </div>
            rank++;
        }
    </div>
}

@code {
    [Parameter] public DataScope Scope { get; set; } = DataScope.ActiveCharacter;

    private bool _showTen;
}
