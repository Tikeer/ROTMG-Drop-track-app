@implements IDisposable
@inject TrackerStateService State
@inject RotmgSnifferService Sniffer
@inject GameDataService GameData
@inject SpriteAtlasService Sprites
@inject AppStartup Startup
@inject UiSettings UiSettings

@if (Sprites.IsReady)
{
    <style>:root { --sprite-atlas: url("rotmg-sprites://localhost/atlas.png?v=@Sprites.Revision"); }</style>
}

@if (Startup.Error != null)
{
    <div class="startup-screen">
        <div class="startup-title">RotMG Tracker could not start</div>
        <div class="startup-sub">@Startup.Error</div>
    </div>
}
else if (!Startup.IsReady)
{
    <div class="startup-screen">
        <div class="startup-spinner"></div>
        <div class="startup-title">RotMG Tracker</div>
        <div class="startup-sub">Loading game data and database...</div>
    </div>
}
else
{
<div class="app-shell">
    <!-- LEFT NAVIGATION SIDEBAR -->
    <aside class="sidebar @(SidebarCollapsed ? "collapsed" : "")">
        <div class="sidebar-top">
            <button class="hamburger-btn" @onclick="ToggleSidebar" title="Menu">
                <UiIcon Name="menu" Size="16" />
            </button>
            <span class="sidebar-brand">RotMG Tracker</span>
        </div>

        @foreach (var nav in NavItems)
        {
            <button class="nav-item @(ActiveTab == nav.Key ? "active" : "")"
                    title="@nav.Label"
                    @onclick="() => SetTab(nav.Key)">
                <span class="nav-icon">
                    @switch (nav.Key)
                    {
                        case "dashboard":
                            <GameSprite ItemId="0x0CE4" Size="20" />
                            break;
                        case "loot":
                            <GameSprite BagObjectType="0x050C" FallbackBagType="BagType.WhiteBag" Size="20" />
                            break;
                        case "dps":
                            <GameSprite BossName="Oryx the Mad God 3" Size="20" />
                            break;
                        case "collection":
                            <GameSprite ItemId="0x0913" Size="20" />
                            break;
                        case "profile":
                            <GameSprite Class="State.ActiveCharacter.Class" SkinId="State.ActiveCharacter.SkinId" Size="20" />
                            break;
                        case "graveyard":
                            <GameSprite TextureFile="lofiChar216x16" TextureIndex="0x16" Size="20" />
                            break;
                        default:
                            <UiIcon Name="@nav.Icon" Size="17" />
                            break;
                    }
                </span>
                <span class="nav-label">@nav.Label</span>
            </button>
        }
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-workspace">

        <!-- SLIM STATUS BAR (KAFELEK 1) -->
        <div class="status-bar">
            <div class="status-bar-left">
                <span class="status-diode @(Sniffer.IsListening ? "online" : "offline")" title="@Sniffer.StatusMessage"></span>
                <span class="status-bar-text" title="@Sniffer.StatusMessage">
                    @(Sniffer.IsListening ? "Sniffer Online" : "Sniffer Offline")
                </span>

                @if (Sniffer.CaptureEnabled)
                {
                    <span class="status-rec" title="@Sniffer.Capture.FilePath">REC</span>
                }

                <span class="status-pill inline-meta-item" title="Current in-game location">
                    <GameSprite PortalObjectType="State.CurrentDungeonPortalType" DungeonName="@State.CurrentDungeonName" Size="16" />
                    <span>@State.CurrentDungeonName@(State.CurrentDungeonGraves > 0 ? $" ({State.CurrentDungeonGraves:0.#}/10)" : "")</span>
                </span>
            </div>

            <div class="status-bar-right">
                @if (!string.IsNullOrEmpty(State.LinkedAccountName))
                {
                    <span class="status-account">@State.LinkedAccountName</span>
                }
                else
                {
                    <span class="status-bar-muted">No account linked</span>
                }

                <button class="btn btn-sm" @onclick='() => SetTab("settings")'>Settings</button>
            </div>
        </div>

        <!-- NEXUS ACCOUNT DETECTION BANNER -->
        @if (!string.IsNullOrEmpty(State.PendingAccountName))
        {
            <div class="char-bar" style="border-color: var(--accent-gold); background: rgba(245, 158, 11, 0.12);">
                <div class="inline-meta-item" style="gap: 8px;">
                    <GameSprite Class="State.PendingAccountClass" Size="22" />
                    <strong style="color: var(--accent-gold);">Detected Player in Nexus:</strong>
                    <span>Joined as <strong>@State.PendingAccountName</strong> (@State.PendingAccountClass). Is this your account?</span>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button class="btn btn-primary btn-sm" @onclick="State.ConfirmPendingAccount">Yes, Link Account</button>
                    <button class="btn btn-sm" @onclick="State.DismissPendingAccount">Ignore</button>
                </div>
            </div>
        }

        <!-- CHARACTER BAR (KAFELEK 2) -->
        <CharacterBar />

        <DailyQuestsPanel />

        <!-- ==================== TAB 1: DASHBOARD ==================== -->
        @if (ActiveTab == "dashboard")
        {
            <DashboardPanel OnSetTab="SetTab" OnOpenFight="OpenLinkedCombatSession" />
        }

        <!-- ==================== TAB 2: LOOT HISTORY ==================== -->
        @if (ActiveTab == "loot")
        {
            <LootPanel OnOpenFight="OpenLinkedCombatSession" />
        }

        <!-- ==================== TAB 3: LIVE DPS & COMBAT HISTORY ==================== -->
        @if (ActiveTab == "dps")
        {
            <DpsPanel @bind-HighlightedSessionId="HighlightedCombatSessionId" />
        }

        <!-- ==================== DEBUG: COUNTERS & DUNGEONS COMPLETED ==================== -->
        @if (ActiveTab == "counters")
        {
            <CountersPanel />
        }

        <!-- ==================== TAB 4: ITEM COLLECTION ==================== -->
        @if (ActiveTab == "collection")
        {
            <CollectionPanel />
        }

        <!-- ==================== TAB 5: PROFILE ==================== -->
        @if (ActiveTab == "profile")
        {
            <ProfilePanel />
        }

        <!-- ==================== TAB 6: GRAVEYARD ==================== -->
        @if (ActiveTab == "graveyard")
        {
            <GraveyardPanel />
        }

        @if (ActiveTab == "settings")
        {
            <SettingsPanel OnSetTab="SetTab" />
        }
    </main>
</div>

}

@code {
    private string ActiveTab { get; set; } = "dashboard";
    private Guid? HighlightedCombatSessionId { get; set; }
    private bool SidebarCollapsed { get; set; } = true;

    private static readonly (string Key, string Icon, string Label)[] NavItems =
    {
        ("dashboard",  "dashboard",  "Live Feed"),
        ("loot",       "loot",       "Loot History"),
        ("dps",        "sword",      "Live DPS & Fights"),
        ("collection", "collection", "Item Collection"),
        ("profile",    "profile",    "Profile"),
        ("graveyard",  "graveyard",  "Graveyard"),
        ("settings",   "settings",   "Settings")
    };

    private void ToggleSidebar() => SidebarCollapsed = !SidebarCollapsed;

    protected override async Task OnInitializedAsync()
    {
        State.OnStateChanged += HandleExternalStateChanged;
        Startup.Changed += HandleExternalStateChanged;
        UiSettings.Changed += HandleExternalStateChanged;
        Sprites.Changed += HandleExternalStateChanged;

        await Startup.StartAsync();
    }

    private void HandleExternalStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private void OpenLinkedCombatSession(Guid sessionId)
    {
        HighlightedCombatSessionId = sessionId;
        ActiveTab = "dps";
    }

    public void Dispose()
    {
        State.OnStateChanged -= HandleExternalStateChanged;
        Startup.Changed -= HandleExternalStateChanged;
        UiSettings.Changed -= HandleExternalStateChanged;
        Sprites.Changed -= HandleExternalStateChanged;
    }
}
