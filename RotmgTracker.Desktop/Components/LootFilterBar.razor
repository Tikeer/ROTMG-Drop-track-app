@* Shared filter bar used by both Live Feed (DashboardPanel) and Loot History (LootPanel) — 100% custom dark dropdowns. *@

@{
    var scopeOptions = new List<DarkSelectOption>
    {
        new("ALL", "All characters"),
        new("ACTIVE", $"Active: {ActiveCharacterTitle}")
    };

    var dungeonOptions = new List<DarkSelectOption> { new("", "All Dungeons") };
    foreach (var d in GetDungeonOptions())
        dungeonOptions.Add(new DarkSelectOption(d, d, DungeonName: d));

    var bossOptions = new List<DarkSelectOption> { new("", "All Bosses") };
    foreach (var b in GetBossOptions())
        bossOptions.Add(new DarkSelectOption(b, b));

    var qualityOptions = new List<DarkSelectOption> { new("", "All Qualities") };
    foreach (var dt in LootFilterState.FilterableQualities)
    {
        var rep = UiHelpers.GetRepresentativeBag(dt);
        qualityOptions.Add(new DarkSelectOption(dt.ToString(), UiHelpers.FormatDropType(dt), BagObjectType: rep.ObjectType, FallbackBag: rep.FallbackBag));
    }
}

<div class="quest-add-bar shared-filter-bar" style="flex-wrap: wrap; overflow: visible;">
    <input class="input"
           style="min-width: 215px; flex: 1; max-width: 280px;"
           placeholder="Search item, boss, dungeon, character..."
           value="@Filter.SearchQuery"
           @oninput="OnSearchInput" />

    <DarkSelect Value="@(Filter.Scope == DataScope.ActiveCharacter ? "ACTIVE" : "ALL")"
                ValueChanged="OnScopeChanged"
                Options="@scopeOptions"
                MinWidth="150px"
                Title="Which characters' drops to show" />

    <DarkSelect Value="@Filter.Dungeon"
                ValueChanged="OnDungeonChanged"
                Options="@dungeonOptions"
                MinWidth="148px"
                Title="Filter by dungeon" />

    @if (!string.IsNullOrEmpty(Filter.Dungeon) && bossOptions.Count > 1)
    {
        <DarkSelect Value="@Filter.Boss"
                    ValueChanged="OnBossChanged"
                    Options="@bossOptions"
                    MinWidth="140px"
                    Title="Filter by boss" />
    }

    <DarkSelect Value="@(Filter.Quality?.ToString() ?? "")"
                ValueChanged="OnQualityChanged"
                Options="@qualityOptions"
                MinWidth="145px"
                Title="Filter by drop quality" />

    <RaritySelect AllowAll="true"
                  AllLabel="All Rarities"
                  Value="Filter.Rarity"
                  ValueChanged="OnRarityChanged"
                  Title="Filter by item rarity" />

    <label class="checkbox-label filter-check-pill" title="Include potions, eggs, and uncategorized drops">
        <input type="checkbox" checked="@Filter.ShowOther" @onchange="OnShowOtherChanged" />
        <span>Junk / Potions</span>
    </label>

    @if (ShowPageSize)
    {
        <DarkSelect Value="@PageSize.ToString()"
                    ValueChanged="OnPageSizeChanged"
                    Options="@PageSizeOptions"
                    MinWidth="112px"
                    AlignRight="true"
                    Title="Bags per page" />
    }

    @if (Filter.HasActiveFilters)
    {
        <button type="button" class="btn btn-sm filter-clear-btn" @onclick="ClearAllAsync" title="Reset active filters">
            Clear
        </button>
    }
</div>

@code {
    private static readonly List<DarkSelectOption> PageSizeOptions =
    [
        new("50", "50 / page"),
        new("100", "100 / page"),
        new("250", "250 / page"),
        new("500", "500 / page")
    ];

    [Parameter, EditorRequired] public LootFilterState Filter { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<LootDropRecord> SourceLoot { get; set; } = Array.Empty<LootDropRecord>();
    [Parameter] public string ActiveCharacterTitle { get; set; } = "";
    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public bool ShowPageSize { get; set; }
    [Parameter] public int PageSize { get; set; } = 100;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private Task NotifyAsync() => OnChanged.InvokeAsync();

    private Task OnSearchInput(ChangeEventArgs e)
    {
        Filter.SearchQuery = e.Value?.ToString() ?? string.Empty;
        return NotifyAsync();
    }

    private Task OnScopeChanged(string val)
    {
        Filter.Scope = val == "ACTIVE" ? DataScope.ActiveCharacter : DataScope.AllCharacters;
        Filter.Dungeon = string.Empty;
        Filter.Boss = string.Empty;
        return NotifyAsync();
    }

    private Task OnDungeonChanged(string val)
    {
        Filter.Dungeon = val;
        Filter.Boss = string.Empty;
        return NotifyAsync();
    }

    private Task OnBossChanged(string val)
    {
        Filter.Boss = val;
        return NotifyAsync();
    }

    private Task OnQualityChanged(string val)
    {
        Filter.Quality = !string.IsNullOrWhiteSpace(val) && Enum.TryParse<DropType>(val, out var dt) ? dt : null;
        return NotifyAsync();
    }

    private Task OnRarityChanged(ItemRarity? rarity)
    {
        Filter.Rarity = rarity;
        return NotifyAsync();
    }

    private Task OnShowOtherChanged(ChangeEventArgs e)
    {
        Filter.ShowOther = e.Value is bool b && b;
        return NotifyAsync();
    }

    private async Task OnPageSizeChanged(string val)
    {
        if (int.TryParse(val, out int size) && size > 0)
        {
            PageSize = size;
            await PageSizeChanged.InvokeAsync(size);
        }
    }

    private Task ClearAllAsync()
    {
        Filter.ClearFilters();
        return NotifyAsync();
    }

    private List<string> GetDungeonOptions() =>
        SourceLoot
            .Select(l => l.DungeonName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<string> GetBossOptions()
    {
        if (string.IsNullOrWhiteSpace(Filter.Dungeon))
            return new List<string>();

        return SourceLoot
            .Where(l => string.Equals(l.DungeonName, Filter.Dungeon, StringComparison.OrdinalIgnoreCase))
            .Select(l => l.BossName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
