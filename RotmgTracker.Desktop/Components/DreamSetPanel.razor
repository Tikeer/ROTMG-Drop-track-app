@inherits StateAwareComponent
@inject GameDataService GameData
@inject ItemSourceService ItemSources

@{
    var scopedLoot = State.GetLootSnapshot(Scope);
    var scopedRuns = State.GetDungeonRunsSnapshot(Scope);
    var itemsByName = GameData.GetAllKnownItems()
        .GroupBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
}

<div class="profile-col-header">
    <div>
        <h3 class="profile-col-title">Dream Set</h3>
        <span class="profile-col-sub">@State.Data.Wishlist.Count(w => w.IsCompleted)/@State.Data.Wishlist.Count achieved</span>
    </div>
    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenModal">+ Add Item</button>
</div>

@if (State.Data.Wishlist.Count == 0)
{
    <div class="empty-state" style="padding: 20px 14px; font-size: 0.84rem;">
        Your dream set is empty. Click <strong>+ Add Item</strong> to track empirical runs and drops.
    </div>
}
else
{
    <div class="profile-col-list">
        @foreach (var wish in State.Data.Wishlist)
        {
            int runsDone = CountRunsSinceAdded(wish, scopedRuns);
            int matchedDrops = CountMatchingDrops(wish, scopedLoot);
            bool achieved = wish.IsCompleted || matchedDrops > 0;
            int spriteItemId = ResolveWishlistSpriteId(wish, itemsByName);

            <div class="dream-item-card @(achieved ? "is-achieved" : "")">
                <div class="dream-item-top">
                    @if (spriteItemId > 0)
                    {
                        <ItemSprite ItemId="spriteItemId"
                                    ItemName="@wish.ItemName"
                                    Rarity="wish.MinimumRarity"
                                    IsShiny="wish.RequireShiny"
                                    Size="38"
                                    ShowTooltip="true" />
                    }
                    <div class="dream-item-info">
                        <div class="dream-item-title-row">
                            <strong class="dream-item-name" style="color: @(wish.RequireShiny ? "#f472b6" : "var(--text-primary)");" title="@wish.ItemName">
                                @wish.ItemName
                            </strong>
                            @if (wish.RequireShiny)
                            {
                                <span class="shiny-pill">SHINY</span>
                            }
                        </div>
                        <div class="dream-item-meta">
                            <GameSprite DungeonName="@wish.TargetDungeonName" Size="15" Title="@wish.TargetDungeonName" />
                            <span class="dream-dungeon-label" title="@wish.TargetDungeonName">@wish.TargetDungeonName</span>
                            <span>•</span>
                            <span class="rarity-text-@wish.MinimumRarity.ToString().ToLowerInvariant()">@wish.MinimumRarity+</span>
                        </div>
                    </div>

                    <button type="button" class="dream-remove-btn" title="Remove from Dream Set" @onclick="() => RemoveWishlistItem(wish.Id)">✕</button>
                </div>

                <div class="dream-item-footer">
                    <span class="dream-stat-chip">
                        Runs since added: <strong>@runsDone</strong>
                    </span>
                    @if (achieved)
                    {
                        <span class="badge-ssnl badge-readonly">
                            @(matchedDrops > 1 ? $"OWNED x{matchedDrops} ✓" : "OWNED ✓")
                        </span>
                    }
                    else
                    {
                        <span class="dream-stat-muted">Hunting</span>
                    }
                </div>
            </div>
        }
    </div>
}

@if (_showModal)
{
    var itemSuggestions = GetItemSuggestions();
    var dungeonSuggestions = GetDungeonSuggestions();
    int previewItemId = ResolvePreviewItemId(out bool hasShinyVariant);

    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-card dream-modal-card" @onclick:stopPropagation="true">
            <div class="modal-title">Add Item to Dream Set</div>

            <div class="dream-modal-preview">
                @if (previewItemId > 0)
                {
                    <ItemSprite ItemId="previewItemId"
                                Rarity="WishMinRarity"
                                IsShiny="WishRequireShiny"
                                Size="46"
                                ShowTooltip="false" />
                }
                else
                {
                    <div class="dream-preview-placeholder">?</div>
                }
                <div class="dream-preview-text">
                    <strong style="color: @(WishRequireShiny ? "#f472b6" : "var(--text-primary)");">
                        @(string.IsNullOrWhiteSpace(WishItemName) ? "Select a target item" : WishItemName)
                    </strong>
                    <span style="font-size: 0.78rem; color: var(--text-muted);">
                        @(string.IsNullOrWhiteSpace(WishDungeonName) ? "Any Dungeon" : WishDungeonName)
                        • Min: <span class="rarity-text-@WishMinRarity.ToString().ToLowerInvariant()">@WishMinRarity</span>
                    </span>
                </div>
            </div>

            <div class="modal-field">
                <label class="modal-label">Target Item</label>
                <div class="autocomplete-host">
                    <input class="input"
                           style="width: 100%;"
                           placeholder="Search item (e.g. Makakoyumi, Divinity)..."
                           value="@WishItemName"
                           @oninput="OnWishItemInput"
                           @onfocus="() => ShowItemMenu = true" />

                    @if (ShowItemMenu && itemSuggestions.Count > 0)
                    {
                        <div class="dropdown-backdrop" @onclick="() => ShowItemMenu = false"></div>
                        <div class="autocomplete-menu">
                            @foreach (var item in itemSuggestions)
                            {
                                <button type="button" class="autocomplete-option" @onclick="() => PickWishItem(item)">
                                    <GameSprite TextureFile="@item.TextureFile" TextureIndex="item.TextureIndex" Size="20" />
                                    <span style="color: @(item.IsShiny ? "#f472b6" : "var(--text-primary)");">@item.Name</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="modal-field">
                <label class="modal-label">Source Dungeon</label>
                <div class="autocomplete-host">
                    <input class="input"
                           style="width: 100%;"
                           placeholder="Auto-filled or pick dungeon..."
                           value="@WishDungeonName"
                           @oninput="OnWishDungeonInput"
                           @onfocus="() => ShowDungeonMenu = true" />

                    @if (ShowDungeonMenu && dungeonSuggestions.Count > 0)
                    {
                        <div class="dropdown-backdrop" @onclick="() => ShowDungeonMenu = false"></div>
                        <div class="autocomplete-menu">
                            @foreach (var p in dungeonSuggestions)
                            {
                                <button type="button" class="autocomplete-option" @onclick="() => PickWishDungeon(p.DungeonName)">
                                    <GameSprite PortalObjectType="p.ObjectType" DungeonName="@p.DungeonName" Size="18" />
                                    <span>@p.DungeonName</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="dream-modal-row">
                <div class="modal-field" style="flex: 1;">
                    <label class="modal-label">Minimum Rarity</label>
                    <RaritySelect AllowAll="false"
                                  Prefix="Min: "
                                  ShowPlusSlots="true"
                                  Value="WishMinRarity"
                                  ValueChanged="OnWishMinRarityChanged"
                                  Title="Minimum required rarity" />
                </div>

                <div class="modal-field" style="justify-content: flex-end; padding-bottom: 6px;">
                    <label class="checkbox-label" title="Switch to the item's Shiny variant sprite and require a Shiny drop">
                        <input type="checkbox" checked="@WishRequireShiny" @onchange="OnRequireShinyChanged" /> Shiny Only
                    </label>
                </div>
            </div>

            @if (WishRequireShiny && !string.IsNullOrWhiteSpace(WishItemName) && !hasShinyVariant)
            {
                <div style="font-size: 0.76rem; color: var(--text-muted);">
                    Note: this item has no dedicated Shiny sprite in local game files.
                </div>
            }

            <div class="modal-actions">
                <button type="button" class="btn btn-sm" @onclick="CloseModal">Cancel</button>
                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@string.IsNullOrWhiteSpace(WishItemName)"
                        @onclick="CreateWishlistTarget">
                    Add to Dream Set
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public DataScope Scope { get; set; } = DataScope.ActiveCharacter;

    private bool _showModal;
    private string WishItemName { get; set; } = "";
    private int WishItemId { get; set; }
    private string WishDungeonName { get; set; } = "";
    private ItemRarity WishMinRarity { get; set; } = ItemRarity.Common;
    private bool WishRequireShiny { get; set; }

    private bool ShowItemMenu { get; set; }
    private bool ShowDungeonMenu { get; set; }

    private void OpenModal()
    {
        WishItemName = "";
        WishItemId = 0;
        WishDungeonName = "";
        WishMinRarity = ItemRarity.Common;
        WishRequireShiny = false;
        ShowItemMenu = false;
        ShowDungeonMenu = false;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        ShowItemMenu = false;
        ShowDungeonMenu = false;
    }

    private void OnWishMinRarityChanged(ItemRarity? value)
    {
        WishMinRarity = value ?? ItemRarity.Common;
    }

    private void OnWishItemInput(ChangeEventArgs e)
    {
        WishItemName = e.Value?.ToString() ?? "";
        WishItemId = 0;
        ShowItemMenu = true;
    }

    private void OnWishDungeonInput(ChangeEventArgs e)
    {
        WishDungeonName = e.Value?.ToString() ?? "";
        ShowDungeonMenu = true;
    }

    private void PickWishItem(ItemMetadata item)
    {
        if (item.IsShiny)
        {
            WishRequireShiny = true;
            WishItemName = item.Name;
            WishItemId = item.ItemId;
        }
        else if (WishRequireShiny)
        {
            var shiny = FindItemByName("Shiny " + item.Name);
            WishItemName = shiny != null ? shiny.Name : item.Name;
            WishItemId = shiny != null ? shiny.ItemId : item.ItemId;
        }
        else
        {
            WishItemName = item.Name;
            WishItemId = item.ItemId;
        }

        // Auto-fill official source dungeon if known
        string? primaryDungeon = ItemSources.GetPrimaryDungeonForItem(WishItemName);
        if (!string.IsNullOrWhiteSpace(primaryDungeon))
            WishDungeonName = primaryDungeon;

        ShowItemMenu = false;
    }

    private void OnRequireShinyChanged(ChangeEventArgs e)
    {
        bool wantShiny = e.Value is bool b && b;
        WishRequireShiny = wantShiny;

        if (string.IsNullOrWhiteSpace(WishItemName))
            return;

        string baseName = ItemSourceService.StripShinyPrefix(WishItemName);
        if (wantShiny)
        {
            var shiny = FindItemByName("Shiny " + baseName);
            if (shiny != null)
            {
                WishItemName = shiny.Name;
                WishItemId = shiny.ItemId;
            }
        }
        else
        {
            var normal = FindItemByName(baseName);
            if (normal != null)
            {
                WishItemName = normal.Name;
                WishItemId = normal.ItemId;
            }
            else if (WishItemName.StartsWith("Shiny ", StringComparison.OrdinalIgnoreCase))
            {
                WishItemName = baseName;
                WishItemId = 0;
            }
        }
    }

    private void PickWishDungeon(string dungeon)
    {
        WishDungeonName = dungeon;
        ShowDungeonMenu = false;
    }

    private ItemMetadata? FindItemByName(string name) =>
        GameData.GetAllKnownItems()
            .FirstOrDefault(i => string.Equals(i.Name, name.Trim(), StringComparison.OrdinalIgnoreCase));

    private int ResolvePreviewItemId(out bool hasShinyVariant)
    {
        hasShinyVariant = false;
        if (string.IsNullOrWhiteSpace(WishItemName))
            return 0;

        string baseName = ItemSourceService.StripShinyPrefix(WishItemName);
        var shiny = FindItemByName("Shiny " + baseName);
        hasShinyVariant = shiny != null;

        if (WishRequireShiny && shiny != null)
            return shiny.ItemId;

        if (WishItemId > 0)
            return WishItemId;

        return FindItemByName(WishItemName)?.ItemId ?? 0;
    }

    private static int ResolveWishlistSpriteId(WishlistTarget wish, Dictionary<string, ItemMetadata> itemsByName)
    {
        string baseName = ItemSourceService.StripShinyPrefix(wish.ItemName);
        if (wish.RequireShiny && itemsByName.TryGetValue("Shiny " + baseName, out var shinyMeta))
            return shinyMeta.ItemId;

        if (wish.ItemId > 0)
            return wish.ItemId;

        if (itemsByName.TryGetValue(wish.ItemName, out var exact))
            return exact.ItemId;

        return itemsByName.TryGetValue(baseName, out var baseMeta) ? baseMeta.ItemId : 0;
    }

    private static int CountRunsSinceAdded(WishlistTarget wish, IReadOnlyList<DungeonRunRecord> scopedRuns)
    {
        if (string.IsNullOrWhiteSpace(wish.TargetDungeonName) ||
            wish.TargetDungeonName.Equals("Any Dungeon", StringComparison.OrdinalIgnoreCase))
        {
            return scopedRuns.Count(r =>
                r.CompletedAt >= wish.CreatedAt &&
                (wish.CompletedAt == null || r.CompletedAt <= wish.CompletedAt));
        }

        return scopedRuns.Count(r =>
            string.Equals(r.DungeonName, wish.TargetDungeonName, StringComparison.OrdinalIgnoreCase) &&
            r.CompletedAt >= wish.CreatedAt &&
            (wish.CompletedAt == null || r.CompletedAt <= wish.CompletedAt));
    }

    private static int CountMatchingDrops(WishlistTarget wish, IReadOnlyList<LootDropRecord> scopedLoot)
    {
        string baseName = ItemSourceService.StripShinyPrefix(wish.ItemName);
        int count = 0;
        foreach (var drop in scopedLoot)
        {
            if (drop.Rarity < wish.MinimumRarity) continue;
            if (wish.RequireShiny && !drop.IsShiny) continue;

            bool idMatch = wish.ItemId > 0 && drop.ItemId == wish.ItemId;
            bool nameMatch = string.Equals(drop.ItemName, wish.ItemName, StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(ItemSourceService.StripShinyPrefix(drop.ItemName), baseName, StringComparison.OrdinalIgnoreCase);

            if (idMatch || nameMatch)
                count++;
        }
        return count;
    }

    private List<ItemMetadata> GetItemSuggestions()
    {
        string q = WishItemName.Trim();
        if (q.Length < 2) return new List<ItemMetadata>();

        return GameData.GetAllKnownItems()
            .Where(i => i.Quality != DropType.BPs && i.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(i => i.Name.StartsWith(q, StringComparison.OrdinalIgnoreCase))
            .ThenBy(i => i.IsShiny)
            .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
            .Take(15)
            .ToList();
    }

    private List<PortalMetadata> GetDungeonSuggestions()
    {
        string q = WishDungeonName.Trim();
        var portals = GameData.GetAllKnownPortals().AsEnumerable();
        if (q.Length > 0)
            portals = portals.Where(p => p.DungeonName.Contains(q, StringComparison.OrdinalIgnoreCase));

        return portals
            .OrderByDescending(p => p.GraveDifficulty)
            .ThenBy(p => p.DungeonName, StringComparer.OrdinalIgnoreCase)
            .Take(12)
            .ToList();
    }

    private void CreateWishlistTarget()
    {
        if (string.IsNullOrWhiteSpace(WishItemName)) return;

        string finalName = WishItemName.Trim();
        int resolvedId = WishItemId;

        if (WishRequireShiny)
        {
            string baseName = ItemSourceService.StripShinyPrefix(finalName);
            var shiny = FindItemByName("Shiny " + baseName);
            if (shiny != null)
            {
                finalName = shiny.Name;
                resolvedId = shiny.ItemId;
            }
        }

        if (resolvedId <= 0)
        {
            var match = FindItemByName(finalName);
            if (match != null) resolvedId = match.ItemId;
        }

        // Empirical tracking only (D16) — EstimatedDropRate is unused in UI
        State.AddWishlistTarget(finalName, WishDungeonName, WishMinRarity, WishRequireShiny, 0.01, resolvedId);
        CloseModal();
    }

    private void RemoveWishlistItem(Guid id)
    {
        State.Data.Wishlist.RemoveAll(w => w.Id == id);
        State.SaveAsync();
    }
}
