@inherits StateAwareComponent
@inject GameDataService GameData

<div class="section-header">
    <h2>Dream Set</h2>
</div>

@{
    var itemSuggestions = GetItemSuggestions();
    var dungeonSuggestions = GetDungeonSuggestions();
}

<div class="quest-add-bar" style="flex-wrap: wrap; overflow: visible;">
    <div class="autocomplete-host" style="min-width: 240px;">
        <input class="input"
               style="width: 100%;"
               placeholder="Search target item (e.g. Makakoyumi)..."
               value="@WishItemName"
               @oninput="OnWishItemInput"
               @onfocus="() => ShowItemMenu = true" />

        @if (ShowItemMenu && itemSuggestions.Count > 0)
        {
            <div class="dropdown-backdrop" @onclick="() => ShowItemMenu = false"></div>
            <div class="autocomplete-menu">
                @foreach (var item in itemSuggestions)
                {
                    <button type="button" class="autocomplete-option" @onclick="() => PickWishItem(item)">
                        <GameSprite TextureFile="@item.TextureFile" TextureIndex="item.TextureIndex" Size="20" />
                        <span style="color: @(item.IsShiny ? "#f472b6" : "var(--text-primary)");">@item.Name</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="autocomplete-host" style="min-width: 190px; max-width: 220px;">
        <input class="input"
               style="width: 100%;"
               placeholder="Target dungeon..."
               value="@WishDungeonName"
               @oninput="OnWishDungeonInput"
               @onfocus="() => ShowDungeonMenu = true" />

        @if (ShowDungeonMenu && dungeonSuggestions.Count > 0)
        {
            <div class="dropdown-backdrop" @onclick="() => ShowDungeonMenu = false"></div>
            <div class="autocomplete-menu">
                @foreach (var p in dungeonSuggestions)
                {
                    <button type="button" class="autocomplete-option" @onclick="() => PickWishDungeon(p.DungeonName)">
                        <GameSprite PortalObjectType="p.ObjectType" DungeonName="@p.DungeonName" Size="18" />
                        <span>@p.DungeonName</span>
                    </button>
                }
            </div>
        }
    </div>

    <select class="select" @bind="WishMinRarity">
        @foreach (var r in Enum.GetValues<ItemRarity>())
        {
            <option value="@r">Min: @r (@((int)r)+ slots)</option>
        }
    </select>

    <div style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem;">
        <span>Drop Rate (1/X):</span>
        <input class="input" type="number" style="width: 80px;" @bind="WishOneInX" min="1" max="10000" />
    </div>

    <label class="checkbox-label">
        <input type="checkbox" @bind="WishRequireShiny" /> Shiny Only
    </label>

    <button class="btn btn-primary" @onclick="CreateWishlistTarget">+ Add to Dream Set</button>
</div>

@if (State.Data.Wishlist.Count == 0)
{
    <div class="empty-state">Your dream set is empty. Add an item above to track dungeon runs and cumulative drop probability!</div>
}
else
{
    var itemsByName = GameData.GetAllKnownItems()
        .GroupBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    <div class="quest-list">
        @foreach (var wish in State.Data.Wishlist)
        {
            int runsDone = State.GetRunsSinceWishlistTargetCreated(wish);
            double cumulativeChance = CalculateWishProbabilityPercent(wish, runsDone);
            double graves = GameData.ResolveDungeonGraveDifficulty(wish.TargetDungeonName);
            int spriteItemId = wish.ItemId > 0
                ? wish.ItemId
                : (itemsByName.TryGetValue(wish.ItemName, out var matched) ? matched.ItemId : 0);

            <div class="quest-row" style="@(wish.IsCompleted ? "border-color: var(--accent-green); background: rgba(34, 197, 94, 0.08);" : "")">
                <div class="inline-meta-item" style="min-width: 260px; gap: 10px;">
                    @if (spriteItemId > 0)
                    {
                        <ItemSprite ItemId="spriteItemId"
                                    Rarity="wish.MinimumRarity"
                                    IsShiny="wish.RequireShiny"
                                    Size="36"
                                    ShowTooltip="false" />
                    }
                    <div>
                        <div class="inline-meta-item">
                            <strong style="font-size: 0.98rem; color: @(wish.RequireShiny ? "#f472b6" : "var(--accent-white)");">
                                @wish.ItemName
                            </strong>
                            @if (wish.RequireShiny)
                            {
                                <span class="shiny-pill">SHINY</span>
                            }
                        </div>
                        <div class="inline-meta-item" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                            <GameSprite DungeonName="@wish.TargetDungeonName" Size="16" Title="@wish.TargetDungeonName" />
                            <span>@wish.TargetDungeonName (@graves.ToString("0.#")/10) • Min: @wish.MinimumRarity</span>
                        </div>
                    </div>
                </div>

                <div class="quest-progress-bar">
                    <div class="quest-progress-fill" style="width: @Math.Min(100, cumulativeChance).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                </div>

                <div style="min-width: 220px; text-align: right; font-size: 0.85rem;">
                    <div>Runs Since Added: <strong>@runsDone</strong></div>
                    <div style="color: var(--accent-gold);">Chance so far: <strong>@cumulativeChance.ToString("0.0")%</strong></div>
                </div>

                <div style="display: flex; gap: 6px; align-items: center;">
                    @if (wish.IsCompleted)
                    {
                        <span class="badge-ssnl badge-readonly">OWNED ✓</span>
                    }
                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveWishlistItem(wish.Id)">✕</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private string WishItemName { get; set; } = "";
    private int WishItemId { get; set; }
    private string WishDungeonName { get; set; } = "";
    private ItemRarity WishMinRarity { get; set; } = ItemRarity.Common;
    private int WishOneInX { get; set; } = 100;
    private bool WishRequireShiny { get; set; }

    private bool ShowItemMenu { get; set; }
    private bool ShowDungeonMenu { get; set; }

    private void OnWishItemInput(ChangeEventArgs e)
    {
        WishItemName = e.Value?.ToString() ?? "";
        WishItemId = 0;
        ShowItemMenu = true;
    }

    private void OnWishDungeonInput(ChangeEventArgs e)
    {
        WishDungeonName = e.Value?.ToString() ?? "";
        ShowDungeonMenu = true;
    }

    private void PickWishItem(ItemMetadata item)
    {
        WishItemName = item.Name;
        WishItemId = item.ItemId;
        if (item.IsShiny) WishRequireShiny = true;
        ShowItemMenu = false;
    }

    private void PickWishDungeon(string dungeon)
    {
        WishDungeonName = dungeon;
        ShowDungeonMenu = false;
    }

    private List<ItemMetadata> GetItemSuggestions()
    {
        string q = WishItemName.Trim();
        if (q.Length < 2) return new List<ItemMetadata>();

        return GameData.GetAllKnownItems()
            .Where(i => i.Quality != DropType.BPs && i.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(i => i.Name.StartsWith(q, StringComparison.OrdinalIgnoreCase))
            .ThenBy(i => i.IsShiny)
            .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
            .Take(15)
            .ToList();
    }

    private List<PortalMetadata> GetDungeonSuggestions()
    {
        string q = WishDungeonName.Trim();
        var portals = GameData.GetAllKnownPortals().AsEnumerable();
        if (q.Length > 0)
            portals = portals.Where(p => p.DungeonName.Contains(q, StringComparison.OrdinalIgnoreCase));

        return portals
            .OrderByDescending(p => p.GraveDifficulty)
            .ThenBy(p => p.DungeonName, StringComparer.OrdinalIgnoreCase)
            .Take(12)
            .ToList();
    }

    private static double CalculateWishProbabilityPercent(WishlistTarget wish, int runs)
    {
        if (runs <= 0 || wish.EstimatedDropRate <= 0) return 0.0;
        double p = Math.Clamp(wish.EstimatedDropRate, 0.00001, 1.0);
        return Math.Round((1.0 - Math.Pow(1.0 - p, runs)) * 100.0, 2);
    }

    private void CreateWishlistTarget()
    {
        if (string.IsNullOrWhiteSpace(WishItemName)) return;

        int resolvedId = WishItemId;
        if (resolvedId <= 0)
        {
            var match = GameData.GetAllKnownItems()
                .FirstOrDefault(i => string.Equals(i.Name, WishItemName.Trim(), StringComparison.OrdinalIgnoreCase));
            if (match != null) resolvedId = match.ItemId;
        }

        double rate = 1.0 / Math.Max(1, WishOneInX);
        State.AddWishlistTarget(WishItemName, WishDungeonName, WishMinRarity, WishRequireShiny, rate, resolvedId);
        WishItemName = "";
        WishItemId = 0;
        ShowItemMenu = false;
        ShowDungeonMenu = false;
    }

    private void RemoveWishlistItem(Guid id)
    {
        State.Data.Wishlist.RemoveAll(w => w.Id == id);
        State.SaveAsync();
    }
}
